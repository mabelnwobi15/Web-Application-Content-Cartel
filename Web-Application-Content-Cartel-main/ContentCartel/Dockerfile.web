# ---------- Build ----------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Restore first (cached unless the .csproj changes)
COPY ContentCartel/ContentCartel.csproj ContentCartel/
RUN dotnet restore ContentCartel/ContentCartel.csproj

COPY ContentCartel/ ContentCartel/
RUN dotnet publish ContentCartel/ContentCartel.csproj -c Release -o /app/publish --no-restore

# ---------- Runtime ----------
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

# QuestPDF (PDF reports) needs fontconfig on Linux
RUN apt-get update \
    && apt-get install -y --no-install-recommends libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .

COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN sed -i 's/\r$//' /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh

ENV ASPNETCORE_ENVIRONMENT=Production
ENTRYPOINT ["/docker-entrypoint.sh", "ContentCartel.dll"]