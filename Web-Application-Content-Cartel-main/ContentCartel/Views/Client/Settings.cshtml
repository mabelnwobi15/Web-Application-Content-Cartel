@{
    ViewData["Title"] = "Settings";

    var fullName =
        User.Identity?.Name
        ?? "Client";

    var email =
        User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
        ?? "-";
}

<link rel="stylesheet"
      href="~/css/client-portal.css"
      asp-append-version="true" />

<section class="client-portal">

    <div class="container">

        <div class="row g-4">

            <aside class="col-12 col-lg-3">
                @await Html.PartialAsync("_ClientPortalNav")
            </aside>

            <main class="col-12 col-lg-9">

                <div class="client-portal-hero mb-4">

                    <span class="client-portal-label">
                        ACCOUNT
                    </span>

                    <h1 class="h2 fw-bold mt-2 mb-2">
                        Settings
                    </h1>

                    <p class="mb-0">
                        Your account details and security.
                    </p>

                </div>

                <div class="client-portal-card mb-4">

                    <h2 class="h5 fw-bold mb-4">
                        Account
                    </h2>

                    <div class="d-flex justify-content-between border-bottom py-3">
                        <span class="text-muted">Name</span>
                        <strong>@fullName</strong>
                    </div>

                    <div class="d-flex justify-content-between border-bottom py-3">
                        <span class="text-muted">Email</span>
                        <strong>@email</strong>
                    </div>

                    <div class="d-flex justify-content-between py-3">
                        <span class="text-muted">Account type</span>
                        <strong>Client</strong>
                    </div>

                    <div class="mt-3">
                        <a asp-controller="Client"
                           asp-action="Profile"
                           class="btn btn-outline-dark">
                            <i class="bi bi-person-circle me-1"></i>
                            View full profile
                        </a>
                    </div>

                </div>

                <div class="client-portal-card mb-4">

                    <h2 class="h5 fw-bold mb-3">
                        Need to change your details or password?
                    </h2>

                    <p class="text-muted mb-3">
                        Get in touch with Content Cartel and we will update your
                        account for you.
                    </p>

                    <a asp-controller="Contact"
                       asp-action="Index"
                       class="btn btn-dark">
                        <i class="bi bi-chat-dots me-1"></i>
                        Contact us
                    </a>

                </div>

                <div class="client-portal-card">

                    <h2 class="h5 fw-bold mb-3">
                        Sign out
                    </h2>

                    <form asp-controller="Client"
                          asp-action="Logout"
                          method="post">

                        <button type="submit"
                                class="btn btn-outline-dark">
                            <i class="bi bi-box-arrow-right me-1"></i>
                            Log out
                        </button>

                    </form>

                </div>

            </main>

        </div>

    </div>

</section>
