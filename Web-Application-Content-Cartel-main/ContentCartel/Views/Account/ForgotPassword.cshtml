@{
    ViewData["Title"] = "Forgot Password";

    var recaptchaSiteKey =
        Context.RequestServices
            .GetRequiredService<IConfiguration>()[
                "Recaptcha:SiteKey"
            ];
}

<div class="container-fluid p-0 my-0 min-vh-100 d-flex flex-column justify-content-center">

    <div class="row g-0 flex-grow-1 align-items-stretch"
         style="min-height: calc(100vh - 120px);">


        <!-- BRANDING -->

        <div class="col-md-6 bg-cream d-flex flex-column align-items-center justify-content-center p-5 text-center border-end border-secondary border-opacity-10">

            <div class="mb-4">

                <img src="~/images/logo.jpeg"
                     alt="The Content Cartel"
                     style="max-width: 240px; width: 100%; height: auto;" />

            </div>

            <h2 class="display-6 fw-black text-uppercase tracking-wide text-dark mb-0"
                style="font-family: impact, sans-serif;">

                Client Portal

            </h2>

        </div>


        <!-- RESET PASSWORD -->

        <div class="col-md-6 bg-white d-flex flex-column align-items-center justify-content-center p-4 p-md-5">

            <div style="max-width: 380px; width: 100%;">

                <h2 class="fw-black text-dark text-uppercase mb-2 tracking-tight"
                    style="font-family: impact, sans-serif; font-size: 2.2rem;">

                    Reset Password

                </h2>


                <p class="text-muted small mb-4">

                    Enter the email associated with your account and we'll send you instructions to reset your password.

                </p>


                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success small">

                        @TempData["SuccessMessage"]

                    </div>
                }


                <form asp-action="ForgotPassword"
                      method="post"
                      id="forgotPasswordForm">

                    @Html.AntiForgeryToken()


                    <!-- EMAIL -->

                    <div class="mb-4">

                        <label class="form-label text-muted small fw-bold text-uppercase mb-1"
                               style="letter-spacing: 0.5px; font-size: 0.75rem;">

                            EMAIL ADDRESS

                        </label>

                        <input type="email"
                               class="form-control form-control-lg bg-white border-dark text-dark rounded-3 px-3 py-2 fs-6"
                               placeholder="JORDAN@CLIENT.COM"
                               name="email"
                               required />

                    </div>


                    <!-- RECAPTCHA -->

                    <input type="hidden"
                           name="recaptchaToken"
                           id="forgotPasswordRecaptchaToken" />


                    <!-- BUTTON -->

                    <button type="submit"
                            id="forgotPasswordButton"
                            class="btn btn-dark w-100 py-3 fw-bold text-uppercase rounded-3 mb-3 shadow-sm"
                            style="letter-spacing: 1px;">

                        SEND RESET LINK

                    </button>

                </form>


                <!-- LOGIN -->

                <div class="text-center mt-3">

                    <a asp-action="Login"
                       class="text-muted text-uppercase text-decoration-none small fw-bold"
                       style="font-size: 0.75rem; letter-spacing: 0.5px;">

                        REMEMBERED YOUR PASSWORD? LOGIN

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<script src="https://www.google.com/recaptcha/api.js?render=@recaptchaSiteKey"></script>

<script>

    document
        .getElementById("forgotPasswordForm")
        .addEventListener("submit", function (event) {

            event.preventDefault();

            const button =
                document.getElementById(
                    "forgotPasswordButton"
                );

            button.disabled = true;

            button.innerText =
                "VERIFYING...";


            grecaptcha.ready(function () {

                grecaptcha
                    .execute(
                        '@recaptchaSiteKey',
                        {
                            action: 'forgot_password'
                        }
                    )
                    .then(function (token) {

                        document
                            .getElementById(
                                "forgotPasswordRecaptchaToken"
                            )
                            .value = token;

                        document
                            .getElementById(
                                "forgotPasswordForm"
                            )
                            .submit();

                    });

            });

        });

</script>