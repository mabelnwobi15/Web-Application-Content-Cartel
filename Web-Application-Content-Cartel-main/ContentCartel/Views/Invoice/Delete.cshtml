@model ContentCartel.Models.Invoice

@{
    ViewData["Title"] = "Delete Invoice";
}

<div class="admin-page">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Delete Invoice
            </h1>

            <p class="text-muted mb-0">
                This action cannot be undone.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>
            Back
        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="admin-card text-center">

                <i class="bi bi-exclamation-triangle-fill
                          text-danger display-4"></i>

                <h3 class="fw-bold mt-3">
                    Delete this invoice?
                </h3>

                <p class="text-muted">
                    You are about to permanently delete:
                </p>


                <div class="border rounded p-4 text-start my-4">

                    <div class="d-flex justify-content-between mb-2">

                        <span class="text-muted">
                            Invoice
                        </span>

                        <strong>
                            @Model.InvoiceNumber
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between mb-2">

                        <span class="text-muted">
                            Client
                        </span>

                        <strong>
                            @Model.ClientName
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between mb-2">

                        <span class="text-muted">
                            Service
                        </span>

                        <strong>
                            @Model.ServiceName
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between">

                        <span class="text-muted">
                            Total
                        </span>

                        <strong>
                            R @Model.TotalAmount.ToString("N2")
                        </strong>

                    </div>

                </div>


                <div class="alert alert-danger text-start">

                    <i class="bi bi-exclamation-triangle me-2"></i>

                    Deleting this invoice will permanently remove it
                    from the invoice records.

                </div>


                <form asp-action="DeleteConfirmed"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.InvoiceId" />


                    <div class="d-flex justify-content-center gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-danger">
                            <i class="bi bi-trash me-2"></i>
                            Delete Invoice
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>