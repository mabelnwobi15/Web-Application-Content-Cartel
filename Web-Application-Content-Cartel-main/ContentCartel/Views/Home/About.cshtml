@{
    ViewData["Title"] = "About Us & Team";
}

<!-- HEADER HERO SECTION -->
<section class="py-5 bg-cream border-bottom border-secondary border-opacity-10 text-center">
    <div class="container py-2">
        <span class="badge bg-gold text-dark text-uppercase px-3 py-2 fw-bold mb-3">Our Agency</span>
        <h1 class="display-4 fw-bold text-uppercase">About Us & Team</h1>
        <p class="lead text-secondary mx-auto" style="max-width: 650px;">
            Meet the multi-disciplinary creators, editors, and strategists behind Content Cartel.
        </p>
    </div>
</section>

<!-- AGENCY BACKGROUND & OVERVIEW SECTION -->
<section class="py-5 bg-white border-bottom border-secondary border-opacity-10">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="badge bg-dark text-gold text-uppercase px-3 py-2 fw-bold mb-3">Established 2023</span>
                <h2 class="display-6 fw-bold text-uppercase mb-3">Engineered for <span class="text-gold">Viral Impact</span></h2>
                <p class="text-secondary mb-3">
                    Content Cartel is a modern digital media hub and creative influencer agency. We specialize in producing high-retention short-form reels, studio podcast recordings, editorial commercial photography, and targeted creator collaborations.
                </p>
                <p class="text-secondary mb-4">
                    We don't just make videos, we build bespoke marketing solutions. By analyzing viewer engagement metrics and user behavior, we ensure every piece of content circulates effectively across modern social algorithms to maximize reach and audience conversion.
                </p>

                <!-- Performance Metrics Grid -->
                <div class="row g-3 text-center">
                    <div class="col-4">
                        <div class="p-3 bg-cream rounded-3 border border-secondary border-opacity-10">
                            <h3 class="fw-bold text-dark mb-0">1M+</h3>
                            <span class="text-muted small text-uppercase">Organic Views</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-cream rounded-3 border border-secondary border-opacity-10">
                            <h3 class="fw-bold text-dark mb-0">100K+</h3>
                            <span class="text-muted small text-uppercase">Interactions</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-cream rounded-3 border border-secondary border-opacity-10">
                            <h3 class="fw-bold text-dark mb-0">100K+</h3>
                            <span class="text-muted small text-uppercase">Audience Reach</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Value Proposition Highlights -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm bg-cream p-4 rounded-3">
                    <h4 class="fw-bold text-uppercase mb-3"><i class="bi bi-stars text-gold me-2"></i> Our Core Capabilities</h4>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-3">
                        <li class="d-flex align-items-start">
                            <i class="bi bi-check-circle-fill text-gold fs-5 me-3 mt-1"></i>
                            <div>
                                <strong class="d-block text-dark">Tailored Content Strategy</strong>
                                <span class="text-secondary small">Custom weekly reel schedules and algorithmic posting guidance prior to release.</span>
                            </div>
                        </li>
                        <li class="d-flex align-items-start">
                            <i class="bi bi-check-circle-fill text-gold fs-5 me-3 mt-1"></i>
                            <div>
                                <strong class="d-block text-dark">Creator & Influencer Matchmaking</strong>
                                <span class="text-secondary small">Connecting brands directly with verified local creators and celebrity partnerships.</span>
                            </div>
                        </li>
                        <li class="d-flex align-items-start">
                            <i class="bi bi-check-circle-fill text-gold fs-5 me-3 mt-1"></i>
                            <div>
                                <strong class="d-block text-dark">Data & Analytics Optimisation</strong>
                                <span class="text-secondary small">In-depth performance tracking and audience preference analysis to adapt future campaigns.</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TEAM / CONTRIBUTORS SECTION -->
<section class="py-5 bg-cream">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="text-uppercase fw-bold text-gold">The Contributors</h2>
            <p class="text-muted">Every campaign is driven by our specialized collaborative network.</p>
        </div>

        <div class="row g-4 d-flex align-items-stretch">
            <!-- Team Member 1 -->
            <div class="col-md-3 col-sm-6 d-flex">
                <div class="card h-100 border-0 shadow-sm p-4 text-center bg-white rounded-3 w-100 d-flex flex-column align-items-center">
                    <div class="rounded-circle bg-cream d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 90px; height: 90px;">
                        <i class="bi bi-person-badge text-gold display-6"></i>
                    </div>
                    <span class="badge bg-gold text-dark text-uppercase px-2 py-1 fw-bold mb-2">Lead Strategist</span>
                    <h5 class="fw-bold mb-1 text-dark">Creative Director</h5>
                    <p class="text-muted small mb-0 mt-2">Oversees video direction, brand alignment, and overall campaign aesthetic.</p>
                </div>
            </div>

            <!-- Team Member 2 -->
            <div class="col-md-3 col-sm-6 d-flex">
                <div class="card h-100 border-0 shadow-sm p-4 text-center bg-white rounded-3 w-100 d-flex flex-column align-items-center">
                    <div class="rounded-circle bg-cream d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 90px; height: 90px;">
                        <i class="bi bi-film text-gold display-6"></i>
                    </div>
                    <span class="badge bg-dark text-gold text-uppercase px-2 py-1 fw-bold mb-2">Reels & FX</span>
                    <h5 class="fw-bold mb-1 text-dark">Lead Video Editor</h5>
                    <p class="text-muted small mb-0 mt-2">Specializes in high-retention social media cuts, pacing, and viral effects.</p>
                </div>
            </div>

            <!-- Team Member 3 -->
            <div class="col-md-3 col-sm-6 d-flex">
                <div class="card h-100 border-0 shadow-sm p-4 text-center bg-white rounded-3 w-100 d-flex flex-column align-items-center">
                    <div class="rounded-circle bg-cream d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 90px; height: 90px;">
                        <i class="bi bi-mic text-gold display-6"></i>
                    </div>
                    <span class="badge bg-gold text-dark text-uppercase px-2 py-1 fw-bold mb-2">Podcast Lead</span>
                    <h5 class="fw-bold mb-1 text-dark">Audio Engineer</h5>
                    <p class="text-muted small mb-0 mt-2">Manages multi-cam studio recording, sound mixing, and audio mastering.</p>
                </div>
            </div>

            <!-- Team Member 4 -->
            <div class="col-md-3 col-sm-6 d-flex">
                <div class="card h-100 border-0 shadow-sm p-4 text-center bg-white rounded-3 w-100 d-flex flex-column align-items-center">
                    <div class="rounded-circle bg-cream d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 90px; height: 90px;">
                        <i class="bi bi-people text-gold display-6"></i>
                    </div>
                    <span class="badge bg-dark text-gold text-uppercase px-2 py-1 fw-bold mb-2">Talent Rel</span>
                    <h5 class="fw-bold mb-1 text-dark">Influencer Manager</h5>
                    <p class="text-muted small mb-0 mt-2">Coordinates partnerships, campaign deals, and relationships with local creators.</p>
                </div>
            </div>
        </div>
    </div>
</section>