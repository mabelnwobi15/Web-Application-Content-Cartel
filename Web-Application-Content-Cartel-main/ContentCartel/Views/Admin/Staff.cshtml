@model List<ContentCartel.Models.ViewModels.AdminStaffViewModel>

@{
    ViewData["Title"] = "Staff";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>

    .admin-page {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        padding: 28px 30px 45px;
        overflow-x: hidden;
        box-sizing: border-box;
    }

    /* PAGE HEADER */

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
        color: #111;
    }

    .page-header p {
        margin: 8px 0 0;
        color: #666;
        font-size: 15px;
    }

    /* ADD STAFF BUTTON */

    .primary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        border: none;
        border-radius: 9px;
        background: #1473ea;
        color: white;
        padding: 14px 20px;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: 0.2s ease;
        white-space: nowrap;
    }

    .primary-btn:hover {
        background: #0d5fc5;
        color: white;
    }

    /* ALERTS */

    .alert {
        margin-bottom: 20px;
        padding: 14px 18px;
        border-radius: 9px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .alert-success {
        background: #eaf8f0;
        color: #157347;
        border: 1px solid #b7e4c7;
    }

    .alert-danger {
        background: #fff0f0;
        color: #b42318;
        border: 1px solid #f2b8b5;
    }

    /* CARD */

    .content-card {
        width: 100%;
        min-width: 0;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 3px 15px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .card-header {
        padding: 22px 25px;
        border-bottom: 1px solid #e5e5e5;
    }

    .card-header h2 {
        margin: 0;
        font-size: 19px;
        font-weight: 700;
        color: #111;
    }

    .card-header p {
        margin: 5px 0 0;
        color: #777;
        font-size: 13px;
    }

    /* TABLE */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .staff-table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
    }

    .staff-table th {
        text-align: left;
        padding: 17px 20px;
        background: #fafafa;
        color: #111;
        font-size: 14px;
        font-weight: 700;
        border-bottom: 1px solid #ddd;
        white-space: nowrap;
    }

    .staff-table td {
        padding: 18px 20px;
        border-bottom: 1px solid #e8e8e8;
        color: #333;
        font-size: 14px;
        vertical-align: middle;
    }

    .staff-table tr:last-child td {
        border-bottom: none;
    }

    .staff-name {
        font-weight: 700;
        color: #111;
    }

    .staff-email {
        color: #777;
    }

    /* BADGES */

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 11px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-active {
        background: #159957;
        color: white;
    }

    .badge-biometric {
        background: #159957;
        color: white;
    }

    .badge-role {
        background: #eef1f4;
        color: #333;
        border: 1px solid #d7dce1;
    }

    /* ACTION BUTTON */

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 13px;
        border: 1px solid #9ba3aa;
        border-radius: 7px;
        background: white;
        color: #52606d;
        text-decoration: none;
        font-size: 14px;
        cursor: pointer;
    }

    .action-btn:hover {
        background: #f5f5f5;
        color: #111;
    }

    /* EMPTY STATE */

    .empty-state {
        padding: 65px 25px;
        text-align: center;
        color: #777;
    }

    .empty-state i {
        display: block;
        margin-bottom: 15px;
        font-size: 42px;
        color: #aaa;
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: #333;
        font-size: 18px;
    }

    .empty-state p {
        margin: 0 0 20px;
        color: #777;
    }

    /* MOBILE */

    @@media (max-width: 700px) {

        .admin-page {
            padding: 22px 16px 35px;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .primary-btn {
            width: 100%;
        }

    }

</style>


<div class="admin-page">

    <!-- PAGE HEADER -->

    <div class="page-header">

        <div>

            <h1>
                Staff
            </h1>

            <p>
                Manage staff members, roles and access.
            </p>

        </div>

        <a asp-controller="Admin"
           asp-action="AddStaff"
           class="primary-btn">

            <i class="bi bi-person-plus"></i>

            Add Staff Member

        </a>

    </div>


    <!-- SUCCESS MESSAGE -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">

            <i class="bi bi-check-circle-fill"></i>

            @TempData["SuccessMessage"]

        </div>
    }


    <!-- ERROR MESSAGE -->

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-circle-fill"></i>

            @TempData["ErrorMessage"]

        </div>
    }


    <!-- STAFF CARD -->

    <div class="content-card">

        <div class="card-header">

            <h2>
                Staff Members
            </h2>

            <p>
                @Model.Count staff member(s)
            </p>

        </div>


        <div class="table-wrapper">

            @if (Model != null && Model.Any())
            {

                <table class="staff-table">

                    <thead>

                        <tr>

                            <th>
                                Name
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Role
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Biometric Registration
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var staff in Model)
                        {

                            <tr>

                                <!-- NAME -->

                                <td>

                                    <div class="staff-name">
                                        @staff.FullName
                                    </div>

                                </td>


                                <!-- EMAIL -->

                                <td>

                                    <div class="staff-email">
                                        @staff.Email
                                    </div>

                                </td>


                                <!-- ROLE -->

                                <td>

                                    <span class="badge badge-role">

                                        @(staff.Role == "Admin"
                                            ? "Administrator"
                                            : staff.Role)

                                    </span>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    <span class="badge badge-active">

                                        @staff.Status

                                    </span>

                                </td>


                                <!-- BIOMETRIC -->

                                <td>

                                    @if (staff.BiometricRegistered)
                                    {

                                        <span class="badge badge-biometric">

                                            <i class="bi bi-fingerprint"></i>

                                            Enrolled

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="badge badge-role">

                                            Not Enrolled

                                        </span>

                                    }

                                </td>


                                <!-- ACTION -->

                                <td>

                                    <button type="button"
                                            class="action-btn">

                                        <i class="bi bi-pencil"></i>

                                        Edit Role

                                    </button>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            }
            else
            {

                <!-- EMPTY STATE -->

                <div class="empty-state">

                    <i class="bi bi-people"></i>

                    <h3>
                        No staff members
                    </h3>

                    <p>
                        Add your first staff member to get started.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="AddStaff"
                       class="primary-btn">

                        <i class="bi bi-person-plus"></i>

                        Add Staff Member

                    </a>

                </div>

            }

        </div>

    </div>

</div>