@model List<ContentCartel.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .admin-page { width: 100%; max-width: 100%; min-width: 0; padding: 28px 30px 45px; box-sizing: border-box; }
    .page-header { margin-bottom: 25px; }
    .page-header h1 { margin: 0; font-size: 30px; font-weight: 800; color: #111; }
    .page-header p { margin: 8px 0 0; color: #666; }
    .content-card { background: #fff; border-radius: 14px; box-shadow: 0 3px 15px rgba(0,0,0,.08); overflow: hidden; }
    .table-wrapper { overflow-x: auto; }
    .bk-table { width: 100%; border-collapse: collapse; min-width: 900px; }
    .bk-table th { text-align: left; padding: 14px 16px; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: #77736c; border-bottom: 1px solid #eeeae2; }
    .bk-table td { padding: 14px 16px; font-size: 13px; border-bottom: 1px solid #f1eee7; vertical-align: middle; }
    .sub { font-size: 11px; color: #89847d; margin-top: 2px; }
    .badge-s { display: inline-block; padding: 4px 9px; border-radius: 20px; font-size: 10px; font-weight: 800; text-transform: uppercase; background: #f3efe5; color: #6d665c; }
    .badge-ok { background: #e9f2e9; color: #416044; }
    .badge-done { background: #e8eef5; color: #405a72; }
    .badge-bad { background: #f4e8e5; color: #76504a; }
    .actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .act { padding: 6px 11px; border: 1px solid #d8d4ca; border-radius: 7px; background: #fff; color: #111; font-size: 11px; font-weight: 700; text-decoration: none; cursor: pointer; }
    .act:hover { background: #f3efe5; }
    .act-danger { color: #8a3b30; }
    .alert-box { padding: 12px 16px; border-radius: 8px; margin-bottom: 18px; font-size: 13px; }
    .alert-ok { background: #e9f2e9; color: #416044; }
    .alert-err { background: #f4e8e5; color: #76504a; }
    .empty { padding: 50px 20px; text-align: center; color: #99948c; }
</style>

<div class="admin-page">

    <div class="page-header">
        <h1>Bookings</h1>
        <p>Every booking made by clients.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-box alert-ok">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-box alert-err">@TempData["ErrorMessage"]</div>
    }

    <div class="content-card">
        @if (Model != null && Model.Any())
        {
            <div class="table-wrapper">
                <table class="bk-table">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Service</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Deposit</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            var status = string.IsNullOrWhiteSpace(b.Status) ? "Pending" : b.Status;
                            var statusClass = status.ToLower() switch
                            {
                                "confirmed" => "badge-ok",
                                "approved" => "badge-ok",
                                "completed" => "badge-done",
                                "cancelled" => "badge-bad",
                                "rejected" => "badge-bad",
                                _ => ""
                            };
                            var payClass = string.Equals(b.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase) ? "badge-ok" : "";

                            <tr>
                                <td>
                                    <div><strong>@b.CustomerName</strong></div>
                                    <div class="sub">@b.Email</div>
                                    @if (!string.IsNullOrWhiteSpace(b.Phone))
                                    {
                                        <div class="sub">@b.Phone</div>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(b.ServiceName) ? b.ServiceId : b.ServiceName)</td>
                                <td>
                                    @b.BookingDate.ToString("dd MMM yyyy")
                                    <div class="sub">@b.BookingTime</div>
                                </td>
                                <td>R @b.TotalAmount.ToString("N2")</td>
                                <td>R @b.DepositAmount.ToString("N2")</td>
                                <td><span class="badge-s @statusClass">@status</span></td>
                                <td><span class="badge-s @payClass">@b.PaymentStatus</span></td>
                                <td>
                                    <div class="actions">
                                        <a class="act" asp-action="EditBooking" asp-route-id="@b.Id">Edit</a>
                                        <a class="act" asp-action="RescheduleBooking" asp-route-id="@b.Id">Reschedule</a>
                                        @if (!string.Equals(status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form asp-action="CancelBooking" method="post" style="display:inline"
                                                  onsubmit="return confirm('Cancel this booking?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@b.Id" />
                                                <button type="submit" class="act act-danger">Cancel</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty">No bookings yet. New client bookings will appear here.</div>
        }
    </div>
</div>
