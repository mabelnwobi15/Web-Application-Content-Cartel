@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Content Cartel Admin
    </title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />


    <!-- Site CSS -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <style>

            /* =====================================================
                       GLOBAL
                       ===================================================== */

            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                padding: 0;
                min-height: 100%;
                width: 100%;
                overflow-x: hidden;
            }

            body {
                font-family: Arial, Helvetica, sans-serif;
                background: #f3efe5;
                color: #111111;
            }


            /* =====================================================
                       ADMIN SHELL
                       ===================================================== */

            .admin-shell {
                width: 100%;
                min-height: 100vh;
                display: flex;
                background: #f3efe5;
                overflow-x: hidden;
            }


            /* =====================================================
                       SIDEBAR
                       ===================================================== */

            .admin-sidebar {
                width: 220px;
                min-width: 220px;
                max-width: 220px;
                min-height: 100vh;
                background: #ffffff;
                border-right: 1px solid #c8c8c8;
                padding: 22px 12px 16px 12px;
                display: flex;
                flex-direction: column;
                position: sticky;
                top: 0;
                height: 100vh;
                flex-shrink: 0;
                overflow-y: auto;
                overflow-x: hidden;
            }


            /* =====================================================
                       BRAND
                       ===================================================== */

            .admin-logo {
                min-height: 70px;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 5px 10px;
                margin-bottom: 22px;
                flex-shrink: 0;
            }

            .admin-logo-placeholder {
                color: #111111;
                font-size: 18px;
                line-height: 1.15;
                font-weight: 800;
                letter-spacing: -0.5px;
                text-align: center;
            }


            /* =====================================================
                       ADMIN NAVIGATION
                       ===================================================== */

            .admin-nav {
                display: flex;
                flex-direction: column;
                gap: 4px;
                min-width: 0;
            }

                .admin-nav .nav-link {
                    color: #222222 !important;
                    background: transparent;
                    border-radius: 7px;
                    padding: 11px 13px;
                    font-size: 13px;
                    font-weight: 500;
                    line-height: 1.25;
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    text-decoration: none;
                    transition: background-color 0.15s ease, color 0.15s ease;
                    min-width: 0;
                }

                    .admin-nav .nav-link span {
                        min-width: 0;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                    }

                    .admin-nav .nav-link i {
                        width: 19px;
                        min-width: 19px;
                        font-size: 14px;
                        text-align: center;
                    }

                    .admin-nav .nav-link:hover {
                        background: #111111;
                        color: #ffffff !important;
                    }

                    .admin-nav .nav-link.active {
                        background: #111111;
                        color: #ffffff !important;
                        font-weight: 700;
                    }


            /* =====================================================
                       BOTTOM NAVIGATION
                       ===================================================== */

            .admin-bottom-nav {
                margin-top: auto;
                padding-top: 20px;
                border-top: 1px solid #d2d2d2;
                flex-shrink: 0;
            }

                .admin-bottom-nav .nav-link {
                    color: #111111 !important;
                    background: transparent;
                    border-radius: 7px;
                    padding: 10px 13px;
                    font-size: 13px;
                    font-weight: 500;
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    text-decoration: none;
                    margin-bottom: 3px;
                    min-width: 0;
                }

                    .admin-bottom-nav .nav-link span {
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                    }

                    .admin-bottom-nav .nav-link i {
                        width: 19px;
                        min-width: 19px;
                        font-size: 15px;
                        text-align: center;
                    }

                    .admin-bottom-nav .nav-link:hover {
                        background: #111111;
                        color: #ffffff !important;
                    }


            /* =====================================================
                       MAIN AREA
                       ===================================================== */

            .admin-main {
                flex: 1 1 auto;
                width: calc(100% - 220px);
                max-width: calc(100% - 220px);
                min-width: 0;
                min-height: 100vh;
                background: #f3efe5;
                overflow-x: hidden;
            }


            /* =====================================================
                       TOP BAR
                       ===================================================== */

            .admin-topbar {
                width: 100%;
                max-width: 100%;
                height: 72px;
                padding: 0 30px;
                background: #f3efe5;
                display: flex;
                align-items: center;
                gap: 14px;
                overflow: hidden;
            }

            .admin-topbar-title {
                min-width: 0;
                margin-right: auto;
                font-size: 18px;
                font-weight: 700;
                color: #111111;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }


            /* =====================================================
                       NOTIFICATION
                       ===================================================== */

            .admin-notification {
                width: 34px;
                height: 34px;
                min-width: 34px;
                flex-shrink: 0;
                border-radius: 50%;
                background: #ffffff;
                border: 1px solid #111111;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #111111;
            }

                .admin-notification i {
                    font-size: 14px;
                }


            /* =====================================================
                       ADMIN BADGE
                       ===================================================== */

            .admin-badge {
                background: #111111;
                color: #ffffff;
                padding: 8px 17px;
                border-radius: 7px;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 0.5px;
                flex-shrink: 0;
            }


            /* =====================================================
                       EXIT ADMIN
                       ===================================================== */

            .exit-admin {
                border: 1px solid #111111;
                background: #ffffff;
                color: #111111;
                border-radius: 6px;
                padding: 7px 13px;
                font-size: 12px;
                font-weight: 500;
                text-decoration: none;
                transition: all 0.15s ease;
                flex-shrink: 0;
                white-space: nowrap;
            }

                .exit-admin:hover {
                    background: #111111;
                    color: #ffffff;
                }


            /* =====================================================
                       MAIN CONTENT

                       IMPORTANT:
                       No max-width and no auto margin.
                       This allows the dashboard to use only the
                       space available beside the sidebar.
                       ===================================================== */

            .admin-content {
                width: 100%;
                max-width: 100%;
                min-width: 0;
                margin: 0;
                padding: 12px 30px 40px;
                overflow-x: hidden;
            }


            /* =====================================================
                       ALERTS
                       ===================================================== */

            .admin-alert {
                width: 100%;
                max-width: 100%;
                border-radius: 7px;
                font-size: 12px;
                margin-bottom: 15px;
            }


            /* =====================================================
                       GENERAL ADMIN BUTTON
                       ===================================================== */

            .admin-btn-dark {
                background: #111111;
                color: #ffffff;
                border: 1px solid #111111;
                border-radius: 6px;
                font-size: 12px;
                font-weight: 600;
                padding: 8px 14px;
            }

                .admin-btn-dark:hover {
                    background: #333333;
                    color: #ffffff;
                }


            /* =====================================================
                       RESPONSIVE - 1100PX
                       ===================================================== */

            @@media (max-width: 1100px) {

                .admin-sidebar {
                    width: 200px;
                    min-width: 200px;
                    max-width: 200px;
                }

                .admin-main {
                    width: calc(100% - 200px);
                    max-width: calc(100% - 200px);
                }

                .admin-content {
                    padding-left: 22px;
                    padding-right: 22px;
                }

                .admin-topbar {
                    padding-left: 22px;
                    padding-right: 22px;
                }
            }


            /* =====================================================
                       RESPONSIVE - 900PX
                       ===================================================== */

            @@media (max-width: 900px) {

                .admin-sidebar {
                    width: 190px;
                    min-width: 190px;
                    max-width: 190px;
                    padding-left: 10px;
                    padding-right: 10px;
                }

                .admin-main {
                    width: calc(100% - 190px);
                    max-width: calc(100% - 190px);
                }

                .admin-nav .nav-link {
                    font-size: 12px;
                    padding: 10px;
                }

                .admin-bottom-nav .nav-link {
                    font-size: 12px;
                }

                .admin-content {
                    padding: 12px 20px 30px;
                }

                .admin-topbar {
                    padding: 0 20px;
                }
            }


            /* =====================================================
                       SMALL SCREENS - 650PX
                       ===================================================== */

            @@media (max-width: 650px) {

                .admin-sidebar {
                    width: 175px;
                    min-width: 175px;
                    max-width: 175px;
                    padding: 18px 8px;
                }

                .admin-main {
                    width: calc(100% - 175px);
                    max-width: calc(100% - 175px);
                }

                .admin-logo-placeholder {
                    font-size: 15px;
                }

                .admin-nav .nav-link {
                    font-size: 11px;
                    padding: 9px 8px;
                    gap: 7px;
                }

                    .admin-nav .nav-link i {
                        width: 17px;
                        min-width: 17px;
                        font-size: 13px;
                    }

                .admin-bottom-nav .nav-link {
                    font-size: 11px;
                    padding: 9px 8px;
                }

                .admin-topbar {
                    height: 62px;
                    padding: 0 12px;
                    gap: 7px;
                }

                .admin-topbar-title {
                    font-size: 14px;
                }

                .admin-badge {
                    padding: 6px 10px;
                    font-size: 9px;
                }

                .exit-admin {
                    padding: 6px 8px;
                    font-size: 10px;
                }

                .admin-content {
                    padding: 10px 12px 25px;
                }
            }


            /* =====================================================
                       VERY SMALL SCREENS
                       ===================================================== */

            @@media (max-width: 480px) {

                .admin-sidebar {
                    width: 155px;
                    min-width: 155px;
                    max-width: 155px;
                }

                .admin-main {
                    width: calc(100% - 155px);
                    max-width: calc(100% - 155px);
                }

                .admin-topbar {
                    padding-left: 8px;
                    padding-right: 8px;
                }

                .admin-content {
                    padding-left: 8px;
                    padding-right: 8px;
                }

                .admin-badge {
                    display: none;
                }

                .exit-admin {
                    padding: 6px 7px;
                }
            }

    </style>

</head>


<body>

    <div class="admin-shell">


        <!-- =================================================
             ADMIN SIDEBAR
             ================================================= -->

        <aside class="admin-sidebar">


            <!-- =============================================
                 LOGO
                 ============================================= -->

            <div class="admin-logo">

                <div class="admin-logo-placeholder">

                    CONTENT<br />

                    CARTEL

                </div>

            </div>


            <!-- =============================================
                 ADMIN NAVIGATION

                 ONLY ADMIN FEATURES ARE HERE
                 ============================================= -->

            <nav class="admin-nav">


                <!-- DASHBOARD -->

                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="nav-link @(currentAction == "Dashboard" ? "active" : "")">

                    <i class="bi bi-grid"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- STAFF -->

                <a asp-controller="Admin"
                   asp-action="Staff"
                   class="nav-link @(currentAction == "Staff" ? "active" : "")">

                    <i class="bi bi-people"></i>

                    <span>
                        Staff
                    </span>

                </a>


                <!-- SERVICES & PRICING -->

                <a asp-controller="Admin"
                   asp-action="ServicesPricing"
                   class="nav-link @(currentAction == "ServicesPricing" ? "active" : "")">

                    <i class="bi bi-tag"></i>

                    <span>
                        Services &amp; Pricing
                    </span>

                </a>


                <!-- DISCOUNT & LOYALTY -->

                <a asp-controller="Admin"
                   asp-action="DiscountLoyalty"
                   class="nav-link @(currentAction == "DiscountLoyalty" ? "active" : "")">

                    <i class="bi bi-robot"></i>

                    <span>
                        Discount &amp; Loyalty Bot
                    </span>

                </a>


                <!-- INVOICING & PAYMENTS -->

                <a asp-controller="Admin"
                   asp-action="Invoices"
                   class="nav-link @(currentAction == "Invoices" ? "active" : "")">

                    <i class="bi bi-receipt"></i>

                    <span>
                        Invoicing &amp; Payments
                    </span>

                </a>


                <!-- FILE & GALLERY -->

                <a asp-controller="Admin"
                   asp-action="Gallery"
                   class="nav-link @(currentAction == "Gallery" ? "active" : "")">

                    <i class="bi bi-image"></i>

                    <span>
                        File &amp; Gallery
                    </span>

                </a>


                <!-- REPORTS & ANALYTICS -->

                <a asp-controller="Admin"
                   asp-action="Reports"
                   class="nav-link @(currentAction == "Reports" ? "active" : "")">

                    <i class="bi bi-bar-chart"></i>

                    <span>
                        Reports &amp; Analytics
                    </span>

                </a>


                <!-- SYSTEM SETTINGS -->

                <a asp-controller="Admin"
                   asp-action="Settings"
                   class="nav-link @(currentAction == "Settings" ? "active" : "")">

                    <i class="bi bi-gear"></i>

                    <span>
                        System Settings
                    </span>

                </a>


            </nav>


            <!-- =============================================
                 BOTTOM ADMIN LINKS
                 ============================================= -->

            <div class="admin-bottom-nav">


                <!-- VIEW WEBSITE -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="nav-link">

                    <i class="bi bi-globe"></i>

                    <span>
                        View Website
                    </span>

                </a>


                <!-- LOGOUT -->

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="nav-link">

                    <i class="bi bi-box-arrow-left"></i>

                    <span>
                        Logout
                    </span>

                </a>


            </div>


        </aside>



        <!-- =================================================
             MAIN ADMIN AREA
             ================================================= -->

        <main class="admin-main">


            <!-- =============================================
                 TOP BAR
                 ============================================= -->

            <header class="admin-topbar">


                <!-- PAGE TITLE -->

                <div class="admin-topbar-title">

                    @ViewData["Title"]

                </div>


                <!-- NOTIFICATION -->

                <div class="admin-notification">

                    <i class="bi bi-bell"></i>

                </div>


                <!-- ADMIN BADGE -->

                <span class="admin-badge">
                    ADMIN
                </span>


                <!-- EXIT ADMIN -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="exit-admin">

                    <i class="bi bi-box-arrow-right me-1"></i>

                    Exit Admin

                </a>


            </header>



            <!-- =============================================
                 PAGE CONTENT
                 ============================================= -->

            <div class="admin-content">


                <!-- SUCCESS MESSAGE -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success admin-alert alert-dismissible fade show"
                         role="alert">

                        @TempData["SuccessMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Close">
                        </button>

                    </div>
                }


                <!-- INFO MESSAGE -->
                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info admin-alert alert-dismissible fade show"
                         role="alert">

                        @TempData["InfoMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Close">
                        </button>

                    </div>
                }


                <!-- CURRENT ADMIN PAGE -->
                @RenderBody()


            </div>


        </main>


    </div>



    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

    <audio id="notificationSound" preload="auto">
        <source src="~/sounds/notification.mp3" type="audio/mpeg">
    </audio>

    <script>
            document.addEventListener("DOMContentLoaded", function () {

                const shouldPlay =
                    '@(TempData["PlayNotificationSound"] ?? "")';

                const sound =
                    document.getElementById("notificationSound");

                if (shouldPlay === "true" && sound) {

                    sound.volume = 0.5;

                    sound.play().catch(function (error) {
                        console.log("Notification sound was blocked:", error);
                    });
                }
            });
    </script>
</body>

</html>