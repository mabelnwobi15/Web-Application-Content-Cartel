@model ContentCartel.Models.Booking

@{
    ViewData["Title"] = "Book Appointment";
}

<section class="py-5 bg-cream border-bottom border-secondary border-opacity-10 text-center">
    <div class="container">
        <span class="badge bg-gold text-dark text-uppercase px-3 py-2 fw-bold mb-3">
            Online Booking
        </span>

        <h1 class="display-4 fw-bold text-uppercase">
            Schedule Your Shoot
        </h1>

        <p class="lead text-secondary mx-auto" style="max-width: 600px;">
            Select your service package, choose a date and time, and secure your booking with a 30% deposit payment.
        </p>
    </div>
</section>

<section class="py-5 bg-cream">
    <div class="container" style="max-width: 750px;">

        <div class="card border-0 shadow-sm p-4 bg-white rounded-3">

            <form asp-controller="Booking"
                  asp-action="ConfirmBooking"
                  method="post"
                  id="bookingForm">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- CLIENT DETAILS -->

                <h4 class="fw-bold text-uppercase text-gold mb-3">
                    1. Client Details
                </h4>

                <div class="row g-3 mb-4">

                    <div class="col-md-6">

                        <label asp-for="CustomerName"
                               class="form-label fw-bold small">
                            Full Name
                        </label>

                        <input asp-for="CustomerName"
                               type="text"
                               class="form-control"
                               required
                               placeholder="Jane Doe" />

                        <span asp-validation-for="CustomerName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Email"
                               class="form-label fw-bold small">
                            Email Address
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               required
                               placeholder="jane@example.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-12">

                        <label asp-for="Phone"
                               class="form-label fw-bold small">
                            Phone / WhatsApp Number
                        </label>

                        <input asp-for="Phone"
                               type="tel"
                               class="form-control"
                               required
                               placeholder="+27 82 000 0000" />

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- SERVICE -->

                <h4 class="fw-bold text-uppercase text-gold mb-3">
                    2. Service & Scheduling
                </h4>

                <div class="row g-3 mb-4">

                    <div class="col-md-6">

                        <label asp-for="ServiceId"
                               class="form-label fw-bold small">
                            Select Service
                        </label>

                        <select asp-for="ServiceId"
                                class="form-select"
                                id="packageSelect"
                                required
                                onchange="calculateDeposit()">

                            <option value="reels"
                                    data-name="Short-Form Reels Package"
                                    data-price="3500">

                                Short-Form Reels Package (R3,500)

                            </option>

                            <option value="podcast"
                                    data-name="Podcast Studio Production"
                                    data-price="7800">

                                Podcast Studio Production (R7,800)

                            </option>

                            <option value="creator"
                                    data-name="Influencer Creator Collab"
                                    data-price="12000">

                                Influencer Creator Collab (R12,000)

                            </option>

                        </select>

                        <span asp-validation-for="ServiceId"
                              class="text-danger">
                        </span>


                        <!-- Hidden values -->

                        <input asp-for="ServiceName"
                               type="hidden"
                               id="serviceName" />

                        <input asp-for="TotalAmount"
                               type="hidden"
                               id="totalAmount" />

                        <input asp-for="DepositAmount"
                               type="hidden"
                               id="depositAmount" />

                        <input asp-for="RemainingBalance"
                               type="hidden"
                               id="remainingBalance" />

                    </div>


                    <!-- DATE -->

                    <div class="col-md-3">

                        <label asp-for="BookingDate"
                               class="form-label fw-bold small">
                            Preferred Date
                        </label>

                        <input asp-for="BookingDate"
                               type="date"
                               class="form-control"
                               required
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="BookingDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- TIME -->

                    <div class="col-md-3">

                        <label asp-for="BookingTime"
                               class="form-label fw-bold small">
                            Preferred Time
                        </label>

                        <input asp-for="BookingTime"
                               type="time"
                               class="form-control"
                               required />

                        <span asp-validation-for="BookingTime"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- PRICE -->

                <div class="p-3 bg-light border rounded mb-4">

                    <div class="d-flex justify-content-between align-items-center mb-1">

                        <span class="fw-bold">
                            Total Service Fee:
                        </span>

                        <span class="fw-bold"
                              id="totalPrice">
                            R 3,500.00
                        </span>

                    </div>


                    <div class="d-flex justify-content-between align-items-center text-success fs-5 fw-bold">

                        <span>
                            Required 30% Deposit:
                        </span>

                        <span id="depositPrice">
                            R 1,050.00
                        </span>

                    </div>


                    <div class="d-flex justify-content-between align-items-center mt-1">

                        <span class="text-muted">
                            Remaining Balance:
                        </span>

                        <span class="text-muted"
                              id="remainingPrice">
                            R 2,450.00
                        </span>

                    </div>


                    <small class="text-muted d-block mt-2">
                        The remaining 70% balance is payable upon project completion.
                    </small>

                </div>


                <!-- SUBMIT -->

                <button type="submit"
                        class="btn btn-gold btn-lg w-100 fw-bold text-uppercase">

                    Proceed to Pay 30% Deposit

                </button>

            </form>

        </div>

    </div>
</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function calculateDeposit() {

            const select =
                document.getElementById("packageSelect");

            const selectedOption =
                select.options[select.selectedIndex];

            const serviceName =
                selectedOption.dataset.name;

            const total =
                parseFloat(selectedOption.dataset.price);

            const deposit =
                total * 0.30;

            const remaining =
                total - deposit;


            // Display total

            document.getElementById("totalPrice").innerText =
                "R " + total.toLocaleString(
                    "en-ZA",
                    {
                        minimumFractionDigits: 2
                    }
                );


            // Display deposit

            document.getElementById("depositPrice").innerText =
                "R " + deposit.toLocaleString(
                    "en-ZA",
                    {
                        minimumFractionDigits: 2
                    }
                );


            // Display remaining

            document.getElementById("remainingPrice").innerText =
                "R " + remaining.toLocaleString(
                    "en-ZA",
                    {
                        minimumFractionDigits: 2
                    }
                );


            // Submit values

            document.getElementById("serviceName").value =
                serviceName;

            document.getElementById("totalAmount").value =
                total;

            document.getElementById("depositAmount").value =
                deposit;

            document.getElementById("remainingBalance").value =
                remaining;
        }


        document.addEventListener(
            "DOMContentLoaded",
            function () {

                calculateDeposit();

            }
        );

    </script>
}