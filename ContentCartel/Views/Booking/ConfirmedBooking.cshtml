@model ContentCartel.Models.Booking

@{
    ViewData["Title"] = "Booking Confirmed";
}

<section class="py-5 bg-cream min-vh-100">

    <div class="container" style="max-width: 850px;">

        <!-- SUCCESS HEADER -->

        <div class="text-center mb-5">

            <div class="mb-4">
                <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle bg-success text-white"
                     style="width: 80px; height: 80px;">

                    <span style="font-size: 40px;">
                        ✓
                    </span>

                </div>
            </div>

            <span class="badge bg-gold text-dark text-uppercase px-3 py-2 fw-bold mb-3">
                Booking Confirmed
            </span>

            <h1 class="display-5 fw-bold text-uppercase">
                You're All Booked!
            </h1>

            <p class="lead text-secondary mx-auto"
               style="max-width: 650px;">

                Thank you for booking with Content Cartel.
                Your booking has been successfully received.

            </p>

        </div>


        <!-- BOOKING CARD -->

        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">

            <div class="card-header bg-dark text-white p-4">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <small class="text-uppercase text-secondary">
                            Booking Reference
                        </small>

                        <h5 class="mb-0 mt-1">
                            @Model.Id
                        </h5>

                    </div>

                    <span class="badge bg-success">
                        @Model.Status
                    </span>

                </div>

            </div>


            <div class="card-body p-4 p-md-5">

                <!-- CLIENT -->

                <h5 class="fw-bold text-uppercase text-gold mb-3">
                    Client Details
                </h5>

                <div class="row g-4 mb-5">

                    <div class="col-md-6">

                        <small class="text-muted d-block">
                            Full Name
                        </small>

                        <strong>
                            @Model.CustomerName
                        </strong>

                    </div>


                    <div class="col-md-6">

                        <small class="text-muted d-block">
                            Email
                        </small>

                        <strong>
                            @Model.Email
                        </strong>

                    </div>


                    <div class="col-md-6">

                        <small class="text-muted d-block">
                            Phone / WhatsApp
                        </small>

                        <strong>
                            @Model.Phone
                        </strong>

                    </div>

                </div>


                <!-- SERVICE -->

                <h5 class="fw-bold text-uppercase text-gold mb-3">
                    Booking Details
                </h5>

                <div class="row g-4 mb-5">

                    <div class="col-md-6">

                        <small class="text-muted d-block">
                            Service
                        </small>

                        <strong>
                            @Model.ServiceName
                        </strong>

                    </div>


                    <div class="col-md-3">

                        <small class="text-muted d-block">
                            Date
                        </small>

                        <strong>
                            @Model.BookingDate.ToString("dd MMM yyyy")
                        </strong>

                    </div>


                    <div class="col-md-3">

                        <small class="text-muted d-block">
                            Time
                        </small>

                        <strong>
                            @Model.BookingTime
                        </strong>

                    </div>

                </div>


                <!-- PAYMENT -->

                <h5 class="fw-bold text-uppercase text-gold mb-3">
                    Payment Summary
                </h5>

                <div class="bg-light border rounded p-4">

                    <div class="d-flex justify-content-between mb-3">

                        <span>
                            Total Service Fee
                        </span>

                        <strong>
                            R @Model.TotalAmount.ToString("N2")
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between mb-3">

                        <span>
                            30% Deposit
                        </span>

                        <strong class="text-success">
                            R @Model.DepositAmount.ToString("N2")
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between">

                        <span>
                            Remaining Balance
                        </span>

                        <strong>
                            R @Model.RemainingBalance.ToString("N2")
                        </strong>

                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">

                        <span class="fw-bold">
                            Payment Status
                        </span>

                        <span class="badge bg-warning text-dark">
                            @Model.PaymentStatus
                        </span>

                    </div>

                </div>

            </div>


            <!-- FOOTER -->

            <div class="card-footer bg-white border-0 p-4">

                <div class="row g-3">

                    <div class="col-md-6">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-dark w-100">

                            Back to Home

                        </a>

                    </div>


                    <div class="col-md-6">

                        <button type="button"
                                class="btn btn-gold w-100"
                                onclick="window.print()">

                            Print Booking

                        </button>

                    </div>

                </div>

            </div>

        </div>


        <!-- MESSAGE -->

        <div class="text-center mt-4">

            <p class="text-muted mb-1">
                Please keep your booking reference:
            </p>

            <strong>
                @Model.Id
            </strong>

        </div>

    </div>

</section>