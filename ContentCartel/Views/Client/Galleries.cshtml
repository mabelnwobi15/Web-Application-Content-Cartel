@model IEnumerable<ContentCartel.Models.GalleryItem>

@{
    ViewData["Title"] = "My Galleries";

    var galleries = Model?.ToList()
        ?? new List<ContentCartel.Models.GalleryItem>();
}

<link rel="stylesheet"
      href="~/css/client-portal.css"
      asp-append-version="true" />

<style>
    /* Gallery buttons: Content Cartel ink black with a gold hover */
    .client-portal .btn-dark {
        background: #1C1A15;
        border-color: #1C1A15;
        color: #fff;
    }

    .client-portal .btn-dark:hover {
        background: #9C7A3C;
        border-color: #9C7A3C;
        color: #fff;
    }

    .client-portal .btn-outline-dark {
        color: #1C1A15;
        border-color: #1C1A15;
    }

    .client-portal .btn-outline-dark:hover {
        background: #9C7A3C;
        border-color: #9C7A3C;
        color: #fff;
    }
</style>

<section class="client-portal">

    <div class="container">

        <div class="row g-4">

            <aside class="col-12 col-lg-3">
                @await Html.PartialAsync("_ClientPortalNav")
            </aside>

            <main class="col-12 col-lg-9">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success mb-4">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger mb-4">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <div class="client-portal-hero mb-4">

                    <span class="client-portal-label">
                        PRIVATE MEDIA
                    </span>

                    <h1 class="h2 fw-bold mt-2 mb-2">
                        My Galleries
                    </h1>

                    <p class="mb-0">
                        Access your private photos, videos and creative content.
                    </p>

                </div>

                @{
                    var myBookings =
                        ViewBag.Bookings as List<ContentCartel.Models.Booking>
                        ?? new List<ContentCartel.Models.Booking>();
                }

                <div class="client-portal-card mb-4" id="upload">

                    <h2 class="h5 fw-bold mb-1">Upload pictures</h2>

                    <p class="text-muted small mb-3">
                        Add your own pictures (JPG, PNG, WEBP, HEIC ...), up to 25 MB each.
                        You can pick several at once.
                    </p>

                    <form asp-controller="Gallery"
                          asp-action="Upload"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Pictures</label>
                                <input type="file" name="files" class="form-control"
                                       accept="image/*" multiple required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Title (optional)</label>
                                <input type="text" name="title" class="form-control"
                                       maxlength="100" placeholder="Defaults to the file name" />
                            </div>

                            @if (myBookings.Any())
                            {
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Booking (optional)</label>
                                    <select name="bookingId" class="form-select">
                                        <option value="">Not linked to a booking</option>
                                        @foreach (var b in myBookings)
                                        {
                                            <option value="@b.Id">
                                                @(string.IsNullOrWhiteSpace(b.ServiceName) ? b.ServiceId : b.ServiceName)
                                                (@b.BookingDate.ToString("dd MMM yyyy"))
                                            </option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Description (optional)</label>
                                <input type="text" name="description" class="form-control" maxlength="200" />
                            </div>

                        </div>

                        <button type="submit" class="btn btn-dark mt-3">
                            <i class="bi bi-cloud-upload me-1"></i>
                            Upload pictures
                        </button>

                    </form>

                </div>

                <div class="row g-3 mb-4">

                    <div class="col-12 col-md-4">
                        <div class="client-portal-card">

                            <small class="text-muted">
                                GALLERIES
                            </small>

                            <h2 class="fw-bold mt-2">
                                @galleries.Count
                            </h2>

                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="client-portal-card">

                            <small class="text-muted">
                                MEDIA
                            </small>

                            <h2 class="fw-bold mt-2">
                                @galleries.Count
                            </h2>

                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="client-portal-card">

                            <small class="text-muted">
                                ACCESS
                            </small>

                            <h2 class="fw-bold mt-2">
                                Private
                            </h2>

                        </div>
                    </div>

                </div>

                <div class="client-portal-card">

                    <h2 class="h4 fw-bold mb-4">
                        Your Media
                    </h2>

                    @if (galleries.Any())
                    {
                        <div class="row g-4">

                            @foreach (var gallery in galleries)
                            {
                                <div class="col-12 col-md-6">
                                    <div class="border rounded-3 p-4 h-100">

                                        @{
                                            var isImage = string.Equals(gallery.MediaType, "Photo", StringComparison.OrdinalIgnoreCase);
                                            var isVideo = string.Equals(gallery.MediaType, "Video", StringComparison.OrdinalIgnoreCase)
                                                          || string.Equals(gallery.MediaType, "Reel", StringComparison.OrdinalIgnoreCase);
                                        }

                                        @if (!string.IsNullOrWhiteSpace(gallery.FileUrl) && isImage)
                                        {
                                            <div class="rounded-3 overflow-hidden mb-3 bg-light" style="height:200px;">
                                                <img src="@gallery.FileUrl" alt="@gallery.Title"
                                                     style="width:100%;height:100%;object-fit:cover;"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                                <div class="h-100 flex-column align-items-center justify-content-center text-muted small text-center p-3"
                                                     style="display:none;">
                                                    <i class="bi bi-image fs-2"></i>
                                                    <span class="mt-2">Preview unavailable. Use Open to view it.</span>
                                                </div>
                                            </div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(gallery.FileUrl) && isVideo)
                                        {
                                            <div class="rounded-3 overflow-hidden mb-3 bg-dark" style="height:200px;">
                                                <video src="@gallery.FileUrl" controls preload="metadata"
                                                       style="width:100%;height:100%;object-fit:cover;"></video>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="rounded-3 mb-3 bg-light d-flex align-items-center justify-content-center text-muted"
                                                 style="height:120px;">
                                                <i class="bi bi-file-earmark fs-1"></i>
                                            </div>
                                        }

                                        <div class="d-flex justify-content-between">
                                            <i class="bi bi-images fs-2"></i>
                                        </div>

                                        <h5 class="fw-bold mt-3">
                                            @gallery.Title
                                        </h5>

                                        @if (!string.IsNullOrWhiteSpace(
                                            gallery.Description))
                                        {
                                            <p class="text-muted small">
                                                @gallery.Description
                                            </p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(
                                            gallery.MediaType))
                                        {
                                            <span class="badge bg-dark">
                                                @gallery.MediaType
                                            </span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(gallery.FileUrl))
                                        {
                                            <a href="@gallery.FileUrl"
                                               target="_blank"
                                               rel="noopener"
                                               class="btn btn-sm btn-outline-dark ms-2">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>
                                                Open / download
                                            </a>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(gallery.FileName))
                                        {
                                            <div class="text-muted small mt-2">
                                                @gallery.FileName
                                                @if (gallery.SizeBytes > 0)
                                                {
                                                    <span>(@((gallery.SizeBytes / 1024.0 / 1024.0).ToString("0.0")) MB)</span>
                                                }
                                            </div>
                                        }

                                    </div>
                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">

                            <i class="bi bi-images fs-1 text-muted"></i>

                            <h4 class="fw-bold mt-3">
                                No galleries yet
                            </h4>

                            <p class="text-muted">
                                Upload your pictures above, or they will appear here
                                once Content Cartel adds your media.
                            </p>

                            <a asp-controller="Booking"
                               asp-action="Index"
                               class="btn btn-dark">
                                Book a Service
                            </a>

                        </div>
                    }

                </div>

                <div class="alert alert-light border mt-4">

                    <div class="d-flex gap-3">

                        <i class="bi bi-lock fs-4"></i>

                        <div>

                            <strong>
                                Private Media
                            </strong>

                            <p class="small text-muted mb-0 mt-1">
                                Your media is private and can only be
                                accessed through your authenticated
                                client account.
                            </p>

                        </div>

                    </div>

                </div>

            </main>

        </div>

    </div>

</section>