@model ContentCartel.Models.UserProfile

@{
    ViewData["Title"] = "My Profile";
}

<link rel="stylesheet"
      href="~/css/client-portal.css"
      asp-append-version="true" />

<section class="client-portal">

    <div class="container">

        <div class="row g-4">

            <aside class="col-12 col-lg-3">

                @await Html.PartialAsync("_ClientPortalNav")

            </aside>


            <main class="col-12 col-lg-9">

                <div class="client-portal-hero mb-4">

                    <span class="client-portal-label">
                        ACCOUNT
                    </span>

                    <h1 class="h2 fw-bold mt-2 mb-2">
                        My Profile
                    </h1>

                    <p class="mb-0">
                        View your account information.
                    </p>

                </div>


                <div class="client-portal-card">

                    <div class="d-flex align-items-center gap-3 mb-4">

                        <div class="rounded-circle bg-dark text-white
                                    d-flex align-items-center
                                    justify-content-center"
                             style="width:70px;height:70px;">

                            <i class="bi bi-person fs-3"></i>

                        </div>

                        <div>

                            <h2 class="h4 fw-bold mb-1">
                                @Model.FullName
                            </h2>

                            <span class="badge bg-dark">
                                @Model.Role
                            </span>

                        </div>

                    </div>


                    <hr />


                    <div class="row g-4 mt-1">

                        <div class="col-12 col-md-6">

                            <label class="form-label text-muted">
                                Full Name
                            </label>

                            <div class="form-control bg-light">
                                @Model.FullName
                            </div>

                        </div>


                        <div class="col-12 col-md-6">

                            <label class="form-label text-muted">
                                Email Address
                            </label>

                            <div class="form-control bg-light">
                                @Model.Email
                            </div>

                        </div>


                        <div class="col-12 col-md-6">

                            <label class="form-label text-muted">
                                Account Type
                            </label>

                            <div class="form-control bg-light">
                                @Model.Role
                            </div>

                        </div>


                        <div class="col-12 col-md-6">

                            <label class="form-label text-muted">
                                Account Status
                            </label>

                            <div class="form-control bg-light">
                                @Model.Status
                            </div>

                        </div>


                        <div class="col-12">

                            <label class="form-label text-muted">
                                User ID
                            </label>

                            <div class="form-control bg-light text-muted">
                                @Model.Uid
                            </div>

                        </div>

                    </div>


                    <div class="alert alert-light border mt-4 mb-0">

                        <div class="d-flex gap-3">

                            <i class="bi bi-shield-check fs-4"></i>

                            <div>

                                <strong>
                                    Account Security
                                </strong>

                                <p class="small text-muted mb-0 mt-1">
                                    Your account is protected by the
                                    Content Cartel authentication system.
                                    Your client information is only
                                    accessible to your account.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </main>

        </div>

    </div>

</section>