@model IEnumerable<ContentCartel.Models.QuoteRequest>

@{
    ViewData["Title"] = "My Quotations";

    var quotations = Model?.ToList()
        ?? new List<ContentCartel.Models.QuoteRequest>();
}

<link rel="stylesheet"
      href="~/css/client-portal.css"
      asp-append-version="true" />

<section class="client-portal">

    <div class="container">

        <div class="row g-4">

            <aside class="col-12 col-lg-3">

                @await Html.PartialAsync("_ClientPortalNav")

            </aside>


            <main class="col-12 col-lg-9">

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger mb-4">
                        @TempData["ErrorMessage"]
                    </div>
                }


                <div class="client-portal-hero mb-4">

                    <span class="client-portal-label">
                        CLIENT PORTAL
                    </span>

                    <h1 class="h2 fw-bold mt-2 mb-2">
                        My Quotations
                    </h1>

                    <p class="mb-0">
                        View your quotation requests and their current status.
                    </p>

                </div>


                <div class="client-portal-card">

                    <div class="d-flex justify-content-between
                                align-items-center mb-4">

                        <div>

                            <h2 class="h4 fw-bold mb-1">
                                Quotation Requests
                            </h2>

                            <p class="text-muted mb-0">
                                @quotations.Count request(s)
                            </p>

                        </div>

                        <a asp-controller="Quote"
                           asp-action="Index"
                           class="btn btn-dark">

                            Request a Quote

                        </a>

                    </div>


                    @if (quotations.Any())
                    {
                        <div class="table-responsive">

                            <table class="table align-middle">

                                <thead>

                                    <tr>

                                        <th>Brand</th>

                                        <th>Media Type</th>

                                        <th>Budget</th>

                                        <th>Estimated Amount</th>

                                        <th>Date</th>

                                        <th>Status</th>

                                        <th></th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var quote in quotations
                                        .OrderByDescending(q => q.CreatedAt))
                                    {
                                        <tr>

                                            <td>
                                                <strong>
                                                    @quote.BrandName
                                                </strong>
                                            </td>

                                            <td>
                                                @quote.MediaType
                                            </td>

                                            <td>
                                                @quote.Budget
                                            </td>
                                            <td>
                                                @{
                                                    decimal estimatedAmount = 0;

                                                    decimal.TryParse(
                                                        Convert.ToString(quote.EstimatedAmount),
                                                        out estimatedAmount
                                                    );
                                                }

                                                @if (estimatedAmount > 0)
                                                {
                                                    <span>
                                                        R @estimatedAmount.ToString("N2")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        To be confirmed
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @quote.CreatedAt.ToString("dd MMM yyyy")
                                            </td>

                                            <td>

                                                <span class="badge bg-dark">
                                                    @quote.Status
                                                </span>

                                            </td>

                                            <td class="text-end">

                                                <a asp-controller="Quote"
                                                   asp-action="QuoteSubmitted"
                                                   asp-route-id="@quote.QuoteRequestId"
                                                   class="btn btn-sm btn-outline-dark">

                                                    View

                                                </a>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">

                            <i class="bi bi-file-earmark-text fs-1 text-muted"></i>

                            <h4 class="fw-bold mt-3">
                                No quotations yet
                            </h4>

                            <p class="text-muted">
                                You haven't submitted a quotation request yet.
                            </p>

                            <a asp-controller="Quote"
                               asp-action="Index"
                               class="btn btn-dark">

                                Request Your First Quote

                            </a>

                        </div>
                    }

                </div>

            </main>

        </div>

    </div>

</section>