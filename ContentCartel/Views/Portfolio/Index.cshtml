@model IEnumerable<ContentCartel.Models.PortfolioItem>

@{
    ViewData["Title"] = "Portfolio";

    var portfolioItems =
        Model?.ToList()
        ?? new List<ContentCartel.Models.PortfolioItem>();

    var categories = portfolioItems
        .Select(item => item.Category)
        .Where(category => !string.IsNullOrWhiteSpace(category))
        .Distinct()
        .OrderBy(category => category)
        .ToList();
}

<link rel="stylesheet"
      href="~/css/portfolio.css"
      asp-append-version="true" />

<div class="portfolio-page">

    <section class="portfolio-hero">
        <div class="container">

            <span class="portfolio-label">
                Our Work
            </span>

            <h1 class="display-4 fw-bold">
                Content Cartel Portfolio
            </h1>

            <p class="lead text-secondary mb-0">
                Explore selected photography, videography and
                digital content created by Content Cartel.
            </p>

        </div>
    </section>


    <section class="portfolio-content">
        <div class="container">

            @if (portfolioItems.Any())
            {
                <div class="portfolio-filter-bar"
                     aria-label="Portfolio categories">

                    <button type="button"
                            class="portfolio-filter active"
                            data-category="all"
                            aria-pressed="true">
                        All
                    </button>

                    @foreach (var category in categories)
                    {
                        <button type="button"
                                class="portfolio-filter"
                                data-category="@category"
                                aria-pressed="false">
                            @category
                        </button>
                    }

                </div>

                <div class="row g-4">

                    @foreach (var item in portfolioItems)
                    {
                        <div class="col-12 col-md-6 col-lg-4"
                             data-portfolio-category="@item.Category">

                            <article class="portfolio-card">

                                <div class="portfolio-card-media">

                                    <img src="@item.CoverImageUrl"
                                         alt="@item.Title"
                                         loading="lazy" />

                                </div>

                                <div class="portfolio-card-body">

                                    <span class="portfolio-category">
                                        @item.Category
                                    </span>

                                    <h2 class="h4 fw-bold mb-2">
                                        @item.Title
                                    </h2>

                                    <p class="text-secondary mb-4">
                                        @item.Description
                                    </p>

                                    <a asp-controller="Portfolio"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-dark w-100">
                                        View Project
                                    </a>

                                </div>

                            </article>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="portfolio-empty-state">

                    <div class="portfolio-empty-icon">
                        <i class="bi bi-images"
                           aria-hidden="true"></i>
                    </div>

                    <h2 class="h4 fw-bold">
                        Portfolio media is being prepared
                    </h2>

                    <p class="text-secondary mx-auto mb-4">
                        Content Cartel projects will appear here.
                    </p>

                </div>
            }

        </div>
    </section>

</div>

<script src="~/js/portfolio.js"
        asp-append-version="true"></script>