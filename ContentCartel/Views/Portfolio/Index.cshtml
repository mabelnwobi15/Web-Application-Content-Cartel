@{
    ViewData["Title"] = "Campaign Portfolio";
}

<section class="py-5 bg-cream border-bottom border-secondary border-opacity-10 text-center">
    <div class="container">
        <span class="badge bg-gold text-dark text-uppercase px-3 py-2 fw-bold mb-3">Our Work</span>
        <h1 class="display-4 fw-bold text-uppercase">Campaign Portfolio</h1>
        <p class="lead text-secondary mx-auto" style="max-width: 600px;">
            Explore our featured short-form videos, photography, and podcast productions.
        </p>
    </div>
</section>

<section class="py-5 bg-cream">
    <div class="container">
        <div class="row g-4 d-flex align-items-stretch">
            
            <!-- Video Reel Item -->
            <div class="col-md-4 d-flex">
                <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden w-100 d-flex flex-column">
                    <div class="position-relative bg-dark overflow-hidden" style="height: 380px;">
                        <img src="https://images.unsplash.com/photo-1511556532299-8f662fc26c06?auto=format&fit=crop&w=600&q=80" 
                             class="w-100 h-100 object-fit-cover" 
                             alt="Urban Lifestyle Brand Campaign">
                        <div class="position-absolute top-50 start-50 translate-middle">
                            <a href="https://www.instagram.com/reel/C7mWLFytaaE/" target="_blank" class="btn btn-gold rounded-circle p-3 shadow-lg d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="bi bi-play-fill fs-2 text-dark"></i>
                            </a>
                        </div>
                    </div>
                    <div class="p-3 d-flex flex-column flex-grow-1 justify-content-between">
                        <div>
                            <span class="badge bg-gold text-dark text-uppercase">Short Reel</span>
                            <h5 class="fw-bold mt-2 mb-1">Urban Lifestyle Brand Campaign</h5>
                            <p class="text-secondary small mb-3">1.2M Organic Views on TikTok</p>
                        </div>
                        <a href="https://www.instagram.com/reel/C7mWLFytaaE/" target="_blank" class="btn btn-outline-dark btn-sm w-100 fw-bold">
                            <i class="bi bi-instagram me-1"></i> Watch Reel
                        </a>
                    </div>
                </div>
            </div>

            <!-- Podcast Episode Item -->
            <div class="col-md-4 d-flex">
                <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden w-100 d-flex flex-column">
                    <div class="position-relative bg-dark overflow-hidden" style="height: 380px;">
                        <img src="https://images.unsplash.com/photo-1590602847861-f357a9332bbc?auto=format&fit=crop&w=600&q=80" 
                             class="w-100 h-100 object-fit-cover" 
                             alt="Creator Talk Ep. 12">
                        <div class="position-absolute top-50 start-50 translate-middle">
                            <a href="https://www.instagram.com/reel/C4QpYvhNarM/" target="_blank" class="btn btn-gold rounded-circle p-3 shadow-lg d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="bi bi-play-fill fs-2 text-dark"></i>
                            </a>
                        </div>
                    </div>
                    <div class="p-3 d-flex flex-column flex-grow-1 justify-content-between">
                        <div>
                            <span class="badge bg-dark text-gold text-uppercase">Podcast Production</span>
                            <h5 class="fw-bold mt-2 mb-1">Creator Talk Ep. 12</h5>
                            <p class="text-secondary small mb-3">Full multi-cam studio setup</p>
                        </div>
                        <a href="https://www.instagram.com/reel/C4QpYvhNarM/" target="_blank" class="btn btn-outline-dark btn-sm w-100 fw-bold">
                            <i class="bi bi-instagram me-1"></i> Watch Episode
                        </a>
                    </div>
                </div>
            </div>

            <!-- Editorial Photography Item -->
            <div class="col-md-4 d-flex">
                <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden w-100 d-flex flex-column">
                    <div class="position-relative bg-dark overflow-hidden" style="height: 380px;">
                        <img src="~/images/portfolioSample1.jpeg" 
                             class="w-100 h-100 object-fit-cover" 
                             alt="Summer Commercial Lookbook" 
                             onerror="this.src='https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=600&q=80'">
                    </div>
                    <div class="p-3 d-flex flex-column flex-grow-1 justify-content-between">
                        <div>
                            <span class="badge bg-secondary text-white text-uppercase">Editorial Photography</span>
                            <h5 class="fw-bold mt-2 mb-1">Summer Commercial Lookbook</h5>
                            <p class="text-secondary small mb-3">20+ High-res deliverables</p>
                        </div>
                        <button class="btn btn-outline-secondary btn-sm w-100 fw-bold" disabled>
                            <i class="bi bi-images me-1"></i> View Gallery
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>