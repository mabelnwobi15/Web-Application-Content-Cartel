<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Content Cartel Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="d-flex">
        <!-- Sidebar Navigation -->
        <div class="bg-dark text-white p-3 min-vh-100 d-flex flex-column" style="width: 260px;">
            <a asp-controller="Admin" asp-action="Dashboard" class="text-white text-decoration-none mb-4 px-2">
                <h4 class="fw-bold text-uppercase mb-0">CONTENT<span class="text-warning">CARTEL</span></h4>
                <small class="text-muted">ADMIN PORTAL</small>
            </a>
            <ul class="nav nav-pills flex-column mb-auto gap-1">
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Dashboard" class="nav-link text-white"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="DiscountLoyalty" class="nav-link text-white"><i class="bi bi-robot me-2"></i> Loyalty & AI</a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Invoices" class="nav-link text-white"><i class="bi bi-receipt me-2"></i> Invoices</a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Gallery" class="nav-link text-white"><i class="bi bi-images me-2"></i> Gallery</a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Staff" class="nav-link text-white"><i class="bi bi-people me-2"></i> Staff</a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="ServicesPricing" class="nav-link text-white"><i class="bi bi-tag me-2"></i> Services & Pricing</a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Reports" class="nav-link text-white"><i class="bi bi-graph-up me-2"></i> Reports</a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Settings" class="nav-link text-white"><i class="bi bi-gear me-2"></i> Settings</a>
                </li>
            </ul>
        </div>

        <!-- Main Content Area -->
        <div class="flex-grow-1">
            <header class="bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">@ViewData["Title"]</h5>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-warning text-dark fw-bold">ADMIN</span>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-right me-1"></i> Exit Admin</a>
                </div>
            </header>

            <main role="main" class="p-3">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        @TempData["InfoMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>