<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Content Cartel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
            :root {
                --cc-cream: #F2EFE9;
                --cc-gold: #C29B47;
                --cc-dark: #1A1A1A;
            }

            body {
                background-color: var(--cc-cream);
                color: var(--cc-dark);
                font-family: system-ui, -apple-system, sans-serif;
            }

            .btn-gold {
                background-color: var(--cc-gold);
                color: #000;
                font-weight: 600;
                border: none;
            }

                .btn-gold:hover {
                    background-color: #a88337;
                    color: #fff;
                }

            .text-gold {
                color: var(--cc-gold) !important;
            }

            .bg-cream {
                background-color: var(--cc-cream) !important;
            }

            .floating-socials {
                position: fixed;
                bottom: 25px;
                right: 25px;
                display: flex;
                flex-column: column;
                gap: 12px;
                z-index: 1000;
            }

            .social-float {
                width: 50px;
                height: 50px;
                border-radius: 50%;
                text-align: center;
                font-size: 24px;
                box-shadow: 2px 4px 10px rgba(0,0,0,0.25);
                display: flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
                transition: transform 0.2s ease, background-color 0.2s ease;
            }

                .social-float:hover {
                    transform: scale(1.1);
                    color: #fff;
                }

            .whatsapp-btn {
                background-color: #25d366;
                color: #FFF;
            }

                .whatsapp-btn:hover {
                    background-color: #1eb954;
                }

            .instagram-btn {
                background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
                color: #FFF;
            }

                .instagram-btn:hover {
                    opacity: 0.95;
                }
    </style>
</head>
<body class="bg-cream text-dark">

    <!-- FLOATING SOCIAL BUTTONS (WhatsApp + Instagram) -->
    <div class="floating-socials">
        <a href="https://www.instagram.com/contentcartel24?stkn=NWxvemx6ZGh4OGlk" class="social-float instagram-btn" target="_blank" aria-label="Visit Instagram">
            <i class="bi bi-instagram"></i>
        </a>
        <a href="https://wa.me/27000000000" class="social-float whatsapp-btn" target="_blank" aria-label="Chat on WhatsApp">
            <i class="bi bi-whatsapp"></i>
        </a>
    </div>

    <!-- TOP HEADER / BRAND BAR -->
    <header class="sticky-top bg-cream border-bottom border-secondary border-opacity-10 py-2">
        <div class="container-fluid d-flex align-items-center justify-content-between px-3 px-md-4">

            <!-- Left: Offcanvas Drawer Toggle Button -->
            <button class="btn d-flex align-items-center gap-2 border-0 fs-5 text-gold p-0"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#drawerNavigation"
                    aria-controls="drawerNavigation">
                <i class="bi bi-list fs-3"></i>
                <span class="fs-6 fw-bold text-uppercase d-none d-sm-inline text-gold">MENU</span>
            </button>

            <!-- Center: Brand Logo & Title -->
            <a class="navbar-brand m-0 d-flex align-items-center gap-2 fw-bold fs-4 text-uppercase text-gold tracking-wider" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.jpeg" alt="Content Cartel Logo" height="40" class="d-inline-block align-text-top" onerror="this.style.display='none'">
                <span>CONTENT CARTEL</span>
            </a>

            <!-- Right: Account Auth Actions (Login / Register) -->
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-dark btn-sm px-3 py-1 fw-bold text-uppercase">
                    Login
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-gold btn-sm px-3 py-1 fw-bold text-uppercase">
                    Register
                </a>
            </div>
        </div>
    </header>

    <!-- DRAWER NAVIGATION (OFFCANVAS) -->
    <div class="offcanvas offcanvas-start bg-cream text-dark border-end"
         tabindex="-1"
         id="drawerNavigation"
         aria-labelledby="drawerNavigationLabel">

        <div class="offcanvas-header border-bottom py-3">
            <div class="d-flex align-items-center gap-2">
                <img src="~/images/logo.jpeg" alt="Logo" height="30" onerror="this.style.display='none'">
                <h5 class="offcanvas-title text-gold fw-bold text-uppercase m-0" id="drawerNavigationLabel">
                    Content Cartel
                </h5>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body d-flex flex-column justify-content-between py-4">
            <nav class="nav flex-column gap-2 fs-5">
                <a class="nav-link text-dark py-2 px-3 rounded hover-gold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door me-2 text-gold"></i> Home
                </a>
                <a class="nav-link text-dark py-2 px-3 rounded hover-gold" asp-controller="Services" asp-action="Index">
                    <i class="bi bi-grid-3x3-gap me-2 text-gold"></i> Services & Pricing
                </a>
                <a class="nav-link text-dark py-2 px-3 rounded hover-gold" asp-controller="Portfolio" asp-action="Index">
                    <i class="bi bi-collection-play me-2 text-gold"></i> Portfolio
                </a>
                <a class="nav-link text-dark py-2 px-3 rounded hover-gold" asp-controller="Quote" asp-action="Index">
                    <i class="bi bi-calculator me-2 text-gold"></i> Request Quote
                </a>
                <a class="nav-link text-dark py-2 px-3 rounded hover-gold" asp-controller="Booking" asp-action="Index">
                    <i class="bi bi-calendar-check me-2 text-gold"></i> Bookings & Appointments
                </a>
                <a class="nav-link text-dark py-2 px-3 rounded hover-gold" asp-controller="Home" asp-action="About">
                    <i class="bi bi-people me-2 text-gold"></i> About Us & Team
                </a>
                <a class="nav-link text-dark py-2 px-3 rounded hover-gold" asp-controller="Contact" asp-action="Index">
                    <i class="bi bi-envelope me-2 text-gold"></i> Contact Us
                </a>
            </nav>

            <div class="border-top pt-3 mt-4">
                <div class="d-flex justify-content-center gap-4 fs-4 text-gold mb-3">
                    <a href="https://www.instagram.com/contentcartel24?stkn=NWxvemx6ZGh4OGlk" target="_blank" class="text-gold" title="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="https://wa.me/27000000000" target="_blank" class="text-gold" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                </div>
                <small class="text-muted text-center d-block">&copy; 2026 Content Cartel. All rights reserved.</small>
            </div>
        </div>
    </div>

    <!-- MAIN BODY CONTENT -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="border-top bg-cream py-4 text-center text-muted small mt-5">
        <div class="container">
            <p class="mb-2 fw-bold text-uppercase text-dark">Content Cartel &bull; Digital Media Hub</p>
            <div class="d-flex justify-content-center gap-3 mb-2">
                <a href="https://wa.me/27000000000" target="_blank" class="text-dark text-decoration-none"><i class="bi bi-whatsapp text-success me-1"></i> WhatsApp</a>
                <span>&bull;</span>
                <a href="https://www.instagram.com/contentcartel24?stkn=NWxvemx6ZGh4OGlk" target="_blank" class="text-dark text-decoration-none"><i class="bi bi-instagram text-danger me-1"></i> Instagram</a>
            </div>
            <p class="mb-0">&copy; 2026 - Content Cartel. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>