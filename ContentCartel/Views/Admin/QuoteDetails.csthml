@model ContentCartel.Models.QuoteRequest

@{
    ViewData["Title"] = "Quote Details";
}

<div class="container-fluid py-4">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Quote Details
            </h1>

            <p class="text-muted mb-0">
                Review the client's quotation request.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Quotations"
           class="btn btn-outline-dark">

            Back to Quotations

        </a>

    </div>


    <div class="row g-4">

        <!-- CLIENT INFORMATION -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        Client Information
                    </h5>


                    <div class="mb-3">

                        <small class="text-muted">
                            Client ID
                        </small>

                        <div class="fw-semibold">
                            @Model.UserId
                        </div>

                    </div>


                    <div class="mb-3">

                        <small class="text-muted">
                            Contact Person
                        </small>

                        <div class="fw-semibold">
                            @Model.CustomerName
                        </div>

                    </div>


                    <div class="mb-3">

                        <small class="text-muted">
                            Phone
                        </small>

                        <div class="fw-semibold">
                            @Model.Phone
                        </div>

                    </div>


                    <div class="mb-3">

                        <small class="text-muted">
                            Brand
                        </small>

                        <div class="fw-semibold">
                            @Model.BrandName
                        </div>

                    </div>


                    <div>

                        <small class="text-muted">
                            Social Media
                        </small>

                        <div class="fw-semibold">
                            @Model.SocialMediaHandle
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- QUOTE INFORMATION -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        Quote Information
                    </h5>


                    <div class="mb-3">

                        <small class="text-muted">
                            Quote ID
                        </small>

                        <div class="fw-semibold">
                            @Model.QuoteRequestId
                        </div>

                    </div>


                    <div class="mb-3">

                        <small class="text-muted">
                            Media Type
                        </small>

                        <div class="fw-semibold">
                            @Model.MediaType
                        </div>

                    </div>


                    <div class="mb-3">

                        <small class="text-muted">
                            Budget
                        </small>

                        <div class="fw-semibold">
                            @Model.Budget
                        </div>

                    </div>


                    <!-- ESTIMATED PRICE -->

                    <div class="mb-3">

                        <small class="text-muted">
                            Estimated Price
                        </small>

                        <div class="fw-semibold">

                            @if (Model.EstimatedAmount.HasValue &&
                                 Model.EstimatedAmount.Value > 0)
                            {
                                <span>
                                    R @Model.EstimatedAmount.Value.ToString("N2")
                                </span>
                            }
                            else
                            {
                                <span>
                                    To be confirmed
                                </span>
                            }

                        </div>

                    </div>


                    <!-- SUBMITTED -->

                    <div class="mb-3">

                        <small class="text-muted">
                            Submitted
                        </small>

                        <div class="fw-semibold">
                            @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        </div>

                    </div>

                    <!-- STATUS -->

                    <div>

                        <small class="text-muted">
                            Status
                        </small>

                        <div class="mt-1">

                            @if (string.Equals(
                                Model.Status,
                                "Approved",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success">
                                    Approved
                                </span>
                            }
                            else if (string.Equals(
                                Model.Status,
                                "Rejected",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-danger">
                                    Rejected
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    @Model.Status
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- CAMPAIGN GOALS -->

        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Campaign Goals
                    </h5>

                    <p class="mb-0">
                        @Model.CampaignGoals
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>