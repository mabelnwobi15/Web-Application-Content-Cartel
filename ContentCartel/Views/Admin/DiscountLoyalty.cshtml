@model IEnumerable<ContentCartel.Models.ViewModels.DiscountRecommendationViewModel>
@{
    ViewData["Title"] = "AI Loyalty & Discount Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">AI Loyalty & Retention Controls</h3>
            <p class="text-muted mb-0">Review and approve AI-recommended promotional discounts.</p>
        </div>
    </div>

    <!-- Active Recommendations -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 bg-white">
                <div class="d-flex justify-content-between">
                    <h5 class="fw-bold">Nova Skincare Studio</h5>
                    <span class="badge bg-success">94% Confidence</span>
                </div>
                <hr />
                <div class="mb-3">
                    <span class="small text-muted d-block">Suggested Discount</span>
                    <h4 class="fw-bold text-primary mb-0">10% OFF Studio Package</h4>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-success flex-grow-1">Approve Discount</button>
                    <button type="button" class="btn btn-outline-danger">Reject</button>
                </div>
            </div>
        </div>
    </div>
</div>