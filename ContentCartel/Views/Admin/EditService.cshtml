@model ContentCartel.Models.Service

@{
    ViewData["Title"] = "Edit Service";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="form-page">

    <div class="page-header">
        <div>
            <h1>Edit Service</h1>
            <p>Update service information and pricing.</p>
        </div>

        <a asp-action="ServicesPricing"
           class="back-btn">
            ← Back
        </a>
    </div>

    <div class="form-card">

        <form asp-action="EditService"
              asp-route-id="@Model.ServiceId"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation"></div>

            <input type="hidden"
                   asp-for="ServiceId" />

            <input type="hidden"
                   asp-for="CreatedAt" />

            <div class="form-group">
                <label asp-for="Category">
                    Category
                </label>

                <input asp-for="Category"
                       class="form-control" />

                <span asp-validation-for="Category"
                      class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Name">
                    Service Name
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="BasePrice">
                    Price (R)
                </label>

                <input asp-for="BasePrice"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="BasePrice"
                      class="field-error"></span>
            </div>

            <div class="checkbox-group">

                <input asp-for="IsActive" />

                <label asp-for="IsActive">
                    Service is active
                </label>

            </div>

            <button type="submit"
                    class="save-btn">
                Save Changes
            </button>

        </form>

    </div>

</div>

<style>

    .form-page {
        padding: 30px;
        max-width: 850px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .page-header h1 {
        margin: 0;
    }

    .page-header p {
        color: #777;
    }

    .back-btn {
        text-decoration: none;
        color: #111;
        background: #f2f2f2;
        padding: 11px 18px;
        border-radius: 8px;
    }

    .form-card {
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        padding: 30px;
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-control {
        width: 100%;
        padding: 13px;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-sizing: border-box;
        font-size: 15px;
    }

    .checkbox-group {
        display: flex;
        gap: 8px;
        align-items: center;
        margin-bottom: 25px;
    }

    .checkbox-group label {
        margin: 0;
    }

    .save-btn {
        width: 100%;
        padding: 14px;
        background: #111;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }

    .validation,
    .field-error {
        color: #b42318;
    }

</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}