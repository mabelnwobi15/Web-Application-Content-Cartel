@model IEnumerable<ContentCartel.Models.ApplicationUser>
@{
    ViewData["Title"] = "Staff Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Staff Management</h3>
            <p class="text-muted mb-0">Manage team members, permissions, and biometric authentication status.</p>
        </div>
        <button class="btn btn-primary"><i class="bi bi-person-plus me-1"></i> Add Staff Member</button>
    </div>

    <div class="card border-0 shadow-sm bg-white p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Staff Member</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Biometric Registration</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold">Alex Rivera</td>
                        <td><span class="badge bg-secondary">Senior Photographer</span></td>
                        <td><span class="badge bg-success">Active</span></td>
                        <td><span class="badge bg-success"><i class="bi bi-fingerprint me-1"></i> Enrolled</span></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary">Edit Role</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>