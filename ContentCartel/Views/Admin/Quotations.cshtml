@model IEnumerable<ContentCartel.Models.QuoteRequest>

@{
    ViewData["Title"] = "Quotations";

    var quotations = Model?.ToList()
        ?? new List<ContentCartel.Models.QuoteRequest>();
}

<div class="container-fluid py-4">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Quote Requests
            </h1>

            <p class="text-muted mb-0">
                View and manage quotation requests submitted by clients.
            </p>
        </div>

        <div>
            <span class="badge bg-dark fs-6">
                @quotations.Count Request(s)
            </span>
        </div>

    </div>


    <!-- ============================================================
         MESSAGES
         ============================================================ -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <!-- ============================================================
         QUOTATIONS
         ============================================================ -->

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @if (quotations.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Client</th>
                                <th>Brand</th>
                                <th>Contact</th>
                                <th>Media Type</th>
                                <th>Budget</th>
                                <th>Estimated Price</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>


                        <tbody>

                            @foreach (var quote in quotations)
                            {
                                <tr>

                                    <!-- CLIENT -->
                                    <td>
                                        <div class="fw-semibold">
                                            @quote.CustomerName
                                        </div>

                                        <small class="text-muted">
                                            @quote.UserId
                                        </small>
                                    </td>

                                    <!-- BRAND -->
                                    <td>
                                        @quote.BrandName
                                    </td>

                                    <!-- CONTACT -->
                                    <td>
                                        @quote.Phone
                                    </td>

                                    <!-- MEDIA TYPE -->
                                    <td>
                                        @quote.MediaType
                                    </td>

                                    <!-- BUDGET -->
                                    <td>
                                        @quote.Budget
                                    </td>

                                    <!-- ESTIMATED PRICE -->
                                    <td>
                                        @{
                                            decimal estimatedAmount = 0;

                                            decimal.TryParse(
                                                Convert.ToString(quote.EstimatedAmount),
                                                out estimatedAmount
                                            );
                                        }

                                        @if (estimatedAmount > 0)
                                        {
                                            <span>
                                                R @estimatedAmount.ToString("N2")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                To be confirmed
                                            </span>
                                        }
                                    </td>

                                    <!-- DATE -->
                                    <td>
                                        @quote.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                    </td>

                                    <!-- STATUS -->
                                    <td>
                                        @if (string.Equals(
                                            quote.Status,
                                            "Approved",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else if (string.Equals(
                                            quote.Status,
                                            "Rejected",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @(string.IsNullOrWhiteSpace(quote.Status)
                                                    ? "Pending"
                                                    : quote.Status)
                                            </span>
                                        }
                                    </td>

                                    <!-- ACTIONS -->
                                    <td>
                                        <a asp-controller="Admin"
                                           asp-action="QuoteDetails"
                                           asp-route-id="@quote.QuoteRequestId"
                                           class="btn btn-sm btn-dark">
                                            View
                                        </a>
                                    </td>

                                </tr>
                            }
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h3 class="fw-bold">
                        No quotation requests
                    </h3>

                    <p class="text-muted">
                        Client quotation requests will appear here
                        once they are submitted.
                    </p>

                </div>
            }

        </div>

    </div>

</div>