@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .admin-page {
        padding: 28px 30px 45px;
        width: 100%;
        max-width: 100%;
    }

    .page-header {
        margin-bottom: 28px;
    }

    h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
    }

    .page-header p {
        margin: 8px 0 0;
        color: #666;
    }

    .analytics-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 18px;
        margin-bottom: 25px;
    }

    .metric {
        background: white;
        border-radius: 14px;
        padding: 22px;
        box-shadow: 0 3px 15px rgba(0,0,0,.08);
    }

    .metric-label {
        color: #777;
        font-size: 13px;
    }

    .metric-value {
        margin-top: 10px;
        font-size: 27px;
        font-weight: 800;
    }

    .report-card {
        background: white;
        border-radius: 14px;
        padding: 25px;
        box-shadow: 0 3px 15px rgba(0,0,0,.08);
    }

        .report-card h2 {
            margin: 0 0 8px;
        }

        .report-card p {
            color: #666;
        }

    .download-btn {
        display: inline-block;
        margin-top: 10px;
        padding: 12px 18px;
        background: #1473ea;
        color: white;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }

    @@media(max-width:950px) {
        .analytics-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media(max-width:550px) {
        .analytics-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="admin-page">

    <div class="page-header">
        <h1>Reports & Analytics</h1>
        <p>Monitor platform activity, bookings, revenue and client engagement.</p>
    </div>

    <div class="analytics-grid">

        <div class="metric">
            <div class="metric-label">Total Bookings</div>
            <div class="metric-value">0</div>
        </div>

        <div class="metric">
            <div class="metric-label">Total Quotes</div>
            <div class="metric-value">0</div>
        </div>

        <div class="metric">
            <div class="metric-label">Revenue</div>
            <div class="metric-value">R0</div>
        </div>

        <div class="metric">
            <div class="metric-label">Active Clients</div>
            <div class="metric-value">0</div>
        </div>

    </div>

    <div class="report-card">

        <h2>Monthly Reports</h2>

        <p>
            Generate and download platform performance reports.
        </p>

        <a asp-action="DownloadReport"
           asp-route-month="@DateTime.Now.ToString("yyyy-MM")"
           class="download-btn">
            <i class="bi bi-download"></i>
            Download Current Report
        </a>

    </div>

</div>