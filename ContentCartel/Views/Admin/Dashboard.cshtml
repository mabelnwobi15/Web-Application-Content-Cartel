@model ContentCartel.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Overview";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-3">
    <h2 class="fw-bold text-uppercase mb-4">Dashboard</h2>

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <span class="text-muted small">128 Bookings</span>
                <h4 class="fw-bold mt-2">Up 14% MoM</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <span class="text-muted small">Pending Approvals</span>
                <h4 class="fw-bold mt-2 text-warning">6 Pending</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <span class="text-muted small">Revenue Month-to-Date</span>
                <h4 class="fw-bold mt-2 text-success">R 284,500</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <span class="text-muted small">Active Clients</span>
                <h4 class="fw-bold mt-2">342 Retained</h4>
            </div>
        </div>
    </div>

    <!-- AI Loyalty & Pending Approvals Queue -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4 bg-white mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-robot text-primary me-2"></i>AI Loyalty & Retention Recommendations</h5>
                    <a asp-controller="Admin" asp-action="DiscountLoyalty" class="btn btn-sm btn-outline-primary">View All</a>
                </div>

                <div class="card border-primary bg-light p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge bg-primary mb-1">94% Confidence</span>
                            <h6 class="fw-bold mb-1">Nova Skincare Studio</h6>
                            <p class="text-muted small mb-2">High client LTV (R 85,000). Re-engagement window open.</p>
                            <span class="fw-bold text-dark">Suggested Discount: 10% Off Studio Shoot</span>
                        </div>
                        <div class="btn-group">
                            <a asp-controller="Admin" asp-action="DiscountLoyalty" class="btn btn-sm btn-success">Approve</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 bg-white h-100">
                <h5 class="fw-bold mb-3">Upcoming Schedule</h5>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 py-2">
                        <span class="badge bg-primary mb-1">09:00 - 12:00</span>
                        <div class="fw-bold">Product Shoot - Beauty Line</div>
                        <small class="text-muted">Studio A</small>
                    </li>
                    <li class="list-group-item px-0 py-2">
                        <span class="badge bg-primary mb-1">13:30 - 16:00</span>
                        <div class="fw-bold">Podcast Recording Session</div>
                        <small class="text-muted">Studio B</small>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>