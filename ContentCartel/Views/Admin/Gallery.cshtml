@model List<ContentCartel.Models.GalleryItem>

@{
    ViewData["Title"] = "File & Gallery";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .admin-page {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        padding: 28px 30px 45px;
        overflow-x: hidden;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 800;
            color: #111;
        }

        .page-header p {
            margin: 8px 0 0;
            color: #666;
            font-size: 15px;
        }

    .primary-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: #1473ea;
        color: white;
        padding: 13px 19px;
        border-radius: 9px;
        text-decoration: none;
        font-weight: 600;
        white-space: nowrap;
    }

        .primary-btn:hover {
            background: #0d5fc5;
            color: white;
        }

    .gallery-card {
        width: 100%;
        min-width: 0;
        background: white;
        border-radius: 14px;
        padding: 25px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.08);
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
    }

    .gallery-item {
        min-width: 0;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
    }

    .gallery-preview {
        height: 190px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f2f2f2;
        overflow: hidden;
    }

        .gallery-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .gallery-preview i {
            font-size: 45px;
            color: #999;
        }

    .gallery-info {
        padding: 16px;
    }

        .gallery-info h3 {
            margin: 0 0 8px;
            font-size: 16px;
            color: #111;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .gallery-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 12px;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 9px;
        border-radius: 6px;
        background: #eef1f4;
        color: #444;
        font-size: 11px;
        font-weight: 700;
    }

    .badge-approved {
        background: #159957;
        color: white;
    }

    .badge-pending {
        background: #e6a817;
        color: white;
    }

    .gallery-details {
        color: #777;
        font-size: 13px;
        line-height: 1.6;
    }

        .gallery-details strong {
            color: #444;
        }

    .gallery-actions {
        display: flex;
        gap: 8px;
        margin-top: 15px;
    }

    .action-btn {
        flex: 1;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        padding: 8px 11px;
        border: 1px solid #aaa;
        border-radius: 7px;
        background: white;
        color: #555;
        text-decoration: none;
        font-size: 13px;
    }

        .action-btn:hover {
            background: #f5f5f5;
            color: #111;
        }

    .empty-state {
        grid-column: 1 / -1;
        padding: 60px 20px;
        text-align: center;
        color: #777;
    }

        .empty-state i {
            display: block;
            margin-bottom: 15px;
            font-size: 45px;
        }

        .empty-state h3 {
            margin: 0 0 8px;
            color: #333;
        }

        .empty-state p {
            margin: 0;
        }

    @@media (max-width: 950px) {
        .gallery-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 650px) {
        .admin-page {
            padding: 22px 16px 35px;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .primary-btn {
            width: 100%;
            justify-content: center;
        }

        .gallery-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="admin-page">

    <div class="page-header">

        <div>
            <h1>File & Gallery</h1>

            <p>
                Manage portfolio files, media and gallery content.
            </p>
        </div>

        <a href="#"
           class="primary-btn">

            <i class="bi bi-cloud-upload"></i>

            Upload File

        </a>

    </div>

    <div class="gallery-card">

        <div class="gallery-grid">

            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="gallery-item">

                        <div class="gallery-preview">

                            @if (!string.IsNullOrWhiteSpace(item.FileUrl))
                            {
                                @if (item.MediaType.Equals(
                                    "Video",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <i class="bi bi-play-circle"></i>
                                }
                                else
                                {
                                    <img src="@item.FileUrl"
                                         alt="@item.Title" />
                                }
                            }
                            else
                            {
                                @if (item.MediaType.Equals(
                                    "Video",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <i class="bi bi-play-circle"></i>
                                }
                                else if (item.MediaType.Equals(
                                    "Reel",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <i class="bi bi-film"></i>
                                }
                                else
                                {
                                    <i class="bi bi-image"></i>
                                }
                            }

                        </div>

                        <div class="gallery-info">

                            <h3 title="@item.Title">
                                @item.Title
                            </h3>

                            <div class="gallery-meta">

                                <span class="badge">
                                    @item.MediaType
                                </span>

                                @if (item.IsApprovedByAdmin)
                                {
                                    <span class="badge badge-approved">
                                        Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-pending">
                                        Pending Approval
                                    </span>
                                }

                            </div>

                            <div class="gallery-details">

                                <div>
                                    <strong>Booking:</strong>
                                    #@item.BookingId
                                </div>

                                <div>
                                    <strong>Uploaded:</strong>
                                    @item.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </div>

                                <div>
                                    <strong>Staff:</strong>
                                    @item.UploadedByStaffId
                                </div>

                            </div>

                            <div class="gallery-actions">

                                <a href="@item.FileUrl"
                                   target="_blank"
                                   class="action-btn">

                                    <i class="bi bi-eye"></i>
                                    View

                                </a>

                                @if (!item.IsApprovedByAdmin)
                                {
                                    <form asp-controller="Admin"
                                          asp-action="ApproveGalleryItem"
                                          method="post"
                                          style="flex:1;">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.GalleryItemId" />

                                        <button type="submit"
                                                class="action-btn"
                                                style="width:100%;">

                                            <i class="bi bi-check-lg"></i>
                                            Approve

                                        </button>

                                    </form>
                                }

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="empty-state">

                    <i class="bi bi-images"></i>

                    <h3>No gallery items yet</h3>

                    <p>
                        Uploaded portfolio media will appear here.
                    </p>

                </div>
            }

        </div>

    </div>

</div>