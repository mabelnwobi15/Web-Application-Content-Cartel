@model List<ContentCartel.Models.GalleryItem>

@{
    ViewData["Title"] = "File & Gallery";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .admin-page {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        padding: 28px 30px 45px;
        overflow-x: hidden;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 800;
            color: #111;
        }

        .page-header p {
            margin: 8px 0 0;
            color: #666;
            font-size: 15px;
        }

    .primary-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: #1C1A15;
        color: white;
        padding: 13px 19px;
        border-radius: 9px;
        text-decoration: none;
        font-weight: 600;
        white-space: nowrap;
    }

        .primary-btn:hover {
            background: #9C7A3C;
            color: white;
        }

    .gallery-card {
        width: 100%;
        min-width: 0;
        background: white;
        border-radius: 14px;
        padding: 25px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.08);
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
    }

    .gallery-item {
        min-width: 0;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
    }

    .gallery-preview {
        height: 190px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f2f2f2;
        overflow: hidden;
    }

        .gallery-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .gallery-preview i {
            font-size: 45px;
            color: #999;
        }

    .gallery-info {
        padding: 16px;
    }

        .gallery-info h3 {
            margin: 0 0 8px;
            font-size: 16px;
            color: #111;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .gallery-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 12px;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 9px;
        border-radius: 6px;
        background: #eef1f4;
        color: #444;
        font-size: 11px;
        font-weight: 700;
    }

    .badge-approved {
        background: #159957;
        color: white;
    }

    .badge-pending {
        background: #e6a817;
        color: white;
    }

    .gallery-details {
        color: #777;
        font-size: 13px;
        line-height: 1.6;
    }

        .gallery-details strong {
            color: #444;
        }

    .gallery-actions {
        display: flex;
        gap: 8px;
        margin-top: 15px;
    }

    .action-btn {
        flex: 1;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        padding: 8px 11px;
        border: 1px solid #aaa;
        border-radius: 7px;
        background: white;
        color: #555;
        text-decoration: none;
        font-size: 13px;
    }

        .action-btn:hover {
            background: #f5f5f5;
            color: #111;
        }

    .empty-state {
        grid-column: 1 / -1;
        padding: 60px 20px;
        text-align: center;
        color: #777;
    }

        .empty-state i {
            display: block;
            margin-bottom: 15px;
            font-size: 45px;
        }

        .empty-state h3 {
            margin: 0 0 8px;
            color: #333;
        }

        .empty-state p {
            margin: 0;
        }

    @@media (max-width: 950px) {
        .gallery-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 650px) {
        .admin-page {
            padding: 22px 16px 35px;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .primary-btn {
            width: 100%;
            justify-content: center;
        }

        .gallery-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="admin-page">

    <div class="page-header">

        <div>
            <h1>File & Gallery</h1>

            <p>
                Manage portfolio files, media and gallery content.
            </p>
        </div>

        <a href="#addMedia"
           class="primary-btn">

            <i class="bi bi-cloud-upload"></i>

            Add Media

        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="padding:12px 16px;border-radius:8px;margin-bottom:18px;background:#e9f2e9;color:#416044;font-size:13px;">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="padding:12px 16px;border-radius:8px;margin-bottom:18px;background:#f4e8e5;color:#76504a;font-size:13px;">
            @TempData["ErrorMessage"]
        </div>
    }

    @{
        var galleryBookings =
            ViewBag.Bookings as List<ContentCartel.Models.Booking>
            ?? new List<ContentCartel.Models.Booking>();
    }

    <div class="gallery-card" id="addMedia" style="margin-bottom:22px;padding:24px;">

        <h3 style="margin:0 0 4px;font-size:17px;font-weight:700;">Add media for a client</h3>

        <p style="margin:0 0 16px;color:#666;font-size:13px;">
            Upload one or more files from your computer (photos, videos, PDFs, any type, up to 100 MB in total).
            Uploads stay hidden from the client until you approve them.
        </p>

        <form asp-controller="Admin" asp-action="AddGalleryItem" method="post" enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;">

                <div>
                    <label style="font-size:12px;font-weight:700;">Booking</label>
                    <select name="bookingId" required
                            style="width:100%;padding:11px;border:1px solid #d0d0d0;border-radius:8px;">
                        <option value="">Select a booking</option>
                        @foreach (var b in galleryBookings)
                        {
                            <option value="@b.Id">
                                @b.CustomerName - @(string.IsNullOrWhiteSpace(b.ServiceName) ? b.ServiceId : b.ServiceName) (@b.BookingDate.ToString("dd MMM yyyy"))
                            </option>
                        }
                    </select>
                </div>

                <div>
                    <label style="font-size:12px;font-weight:700;">Title (optional)</label>
                    <input type="text" name="title" placeholder="Defaults to the file name"
                           style="width:100%;padding:11px;border:1px solid #d0d0d0;border-radius:8px;" />
                </div>

                <div style="grid-column:1 / -1;">
                    <label style="font-size:12px;font-weight:700;">Files</label>
                    <input type="file" name="files" multiple required
                           style="width:100%;padding:9px;border:1px solid #d0d0d0;border-radius:8px;background:#fff;" />
                </div>

                <div style="grid-column:1 / -1;">
                    <label style="font-size:12px;font-weight:700;">Description (optional)</label>
                    <input type="text" name="description"
                           style="width:100%;padding:11px;border:1px solid #d0d0d0;border-radius:8px;" />
                </div>

            </div>

            <button type="submit" class="primary-btn" style="margin-top:16px;border:none;cursor:pointer;">
                <i class="bi bi-plus-lg"></i>
                Upload
            </button>

        </form>

    </div>

    <div class="gallery-card">

        <div class="gallery-grid">

            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="gallery-item">

                        <div class="gallery-preview">

                            @{
                                var isImage = item.MediaType.Equals("Photo", StringComparison.OrdinalIgnoreCase);
                                var isVideo = item.MediaType.Equals("Video", StringComparison.OrdinalIgnoreCase)
                                              || item.MediaType.Equals("Reel", StringComparison.OrdinalIgnoreCase);
                            }

                            @if (!string.IsNullOrWhiteSpace(item.FileUrl) && isImage)
                            {
                                <img src="@item.FileUrl" alt="@item.Title"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />

                                <div style="display:none;text-align:center;padding:10px;">
                                    <i class="bi bi-image" style="font-size:34px;"></i>
                                    <div style="font-size:11px;margin-top:6px;">
                                        Preview unavailable. Use View to open the link.
                                    </div>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(item.FileUrl) && isVideo)
                            {
                                <video src="@item.FileUrl" controls preload="metadata"
                                       style="width:100%;height:100%;object-fit:cover;"></video>
                            }
                            else
                            {
                                <div style="text-align:center;padding:10px;">
                                    <i class="bi bi-file-earmark" style="font-size:34px;"></i>
                                    @if (!string.IsNullOrWhiteSpace(item.FileName))
                                    {
                                        <div style="font-size:11px;margin-top:6px;word-break:break-all;">@item.FileName</div>
                                    }
                                </div>
                            }

                        </div>

                        <div class="gallery-info">

                            <h3 title="@item.Title">
                                @item.Title
                            </h3>

                            <div class="gallery-meta">

                                <span class="badge">
                                    @item.MediaType
                                </span>

                                @if (item.IsApprovedByAdmin)
                                {
                                    <span class="badge badge-approved">
                                        Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-pending">
                                        Pending Approval
                                    </span>
                                }

                            </div>

                            <div class="gallery-details">

                                <div>
                                    <strong>Booking:</strong>
                                    #@item.BookingId
                                </div>

                                <div>
                                    <strong>Uploaded:</strong>
                                    @item.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </div>

                                <div>
                                    <strong>Uploaded by:</strong>
                                    @(string.IsNullOrWhiteSpace(item.UploadedByRole) ? "Admin" : item.UploadedByRole)
                                </div>

                            </div>

                            <div class="gallery-actions">

                                <a href="@item.FileUrl"
                                   target="_blank"
                                   class="action-btn">

                                    <i class="bi bi-eye"></i>
                                    View

                                </a>

                                @if (!item.IsApprovedByAdmin)
                                {
                                    <form asp-controller="Admin"
                                          asp-action="ApproveGalleryItem"
                                          method="post"
                                          style="flex:1;">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="action-btn"
                                                style="width:100%;">

                                            <i class="bi bi-check-lg"></i>
                                            Approve

                                        </button>

                                    </form>
                                }

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="empty-state">

                    <i class="bi bi-images"></i>

                    <h3>No gallery items yet</h3>

                    <p>
                        Uploaded portfolio media will appear here.
                    </p>

                </div>
            }

        </div>

    </div>

</div>