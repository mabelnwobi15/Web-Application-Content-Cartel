@model ContentCartel.Models.Invoice

@{
    ViewData["Title"] = "Invoice " + Model.InvoiceNumber;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var percentPaid =
        Model.TotalAmount > 0
            ? (int)Math.Round(Model.AmountPaid / Model.TotalAmount * 100)
            : 0;

    var payUpper = (Model.PaymentStatus ?? "").ToUpperInvariant();

    var payClass =
        payUpper switch
        {
            "PAID" => "status",
            "PARTIALLY PAID" => "status status-partial",
            "PARTIAL" => "status status-partial",
            "REFUNDED" => "status status-refunded",
            "CANCELLED" => "status status-cancelled",
            _ => "status status-pending"
        };
}

<style>
    .admin-page {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        padding: 28px 30px 45px;
        overflow-x: hidden;
        box-sizing: border-box;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 800;
            color: #111;
        }

        .page-header p {
            margin: 8px 0 0;
            color: #666;
            font-size: 15px;
        }

    .content-card {
        width: 100%;
        min-width: 0;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .card-header {
        padding: 22px 25px;
        border-bottom: 1px solid #e5e5e5;
    }

        .card-header h2 {
            margin: 0;
            font-size: 19px;
            font-weight: 700;
            color: #111;
        }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .admin-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
    }

        .admin-table th {
            padding: 17px 20px;
            background: #fafafa;
            text-align: left;
            color: #111;
            font-size: 14px;
            font-weight: 700;
            border-bottom: 1px solid #ddd;
            white-space: nowrap;
        }

        .admin-table td {
            padding: 18px 20px;
            border-bottom: 1px solid #eee;
            color: #333;
            font-size: 14px;
            vertical-align: middle;
        }

        .admin-table tr:last-child td {
            border-bottom: none;
        }

    .invoice-number {
        font-weight: 700;
        color: #111;
    }

    .client-name {
        font-weight: 600;
        color: #222;
    }

    .service-name {
        color: #666;
        margin-top: 4px;
        font-size: 13px;
    }

    .amount {
        font-weight: 700;
        white-space: nowrap;
    }

    .balance {
        font-weight: 700;
        white-space: nowrap;
    }

    .status {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        border-radius: 7px;
        background: #159957;
        color: white;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-pending {
        background: #e6a817;
    }

    .status-partial {
        background: #2563eb;
    }

    .status-refunded {
        background: #777;
    }

    .status-cancelled {
        background: #c0392b;
    }

    .status-issued {
        background: #555;
    }

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 13px;
        border: 1px solid #aeb4ba;
        border-radius: 7px;
        background: white;
        color: #52606d;
        text-decoration: none;
        font-size: 14px;
        cursor: pointer;
        white-space: nowrap;
    }

        .action-btn:hover {
            background: #f5f5f5;
            color: #111;
        }

    .empty-state {
        padding: 60px 25px;
        text-align: center;
        color: #777;
    }

        .empty-state i {
            display: block;
            margin-bottom: 15px;
            font-size: 42px;
        }

        .empty-state h3 {
            margin: 0 0 8px;
            color: #333;
        }

        .empty-state p {
            margin: 0;
        }

    @@media (max-width: 700px) {
        .admin-page {
            padding: 22px 16px 35px;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 22px;
        margin-bottom: 22px;
    }

    .detail-body {
        padding: 8px 25px 20px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 13px 0;
        border-bottom: 1px solid #eee;
        font-size: 14px;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-row span {
            color: #666;
        }

        .detail-row strong {
            color: #111;
            text-align: right;
            word-break: break-word;
        }

    .progress-track {
        height: 10px;
        background: #eee;
        border-radius: 99px;
        overflow: hidden;
        margin: 16px 25px 4px;
    }

    .progress-fill {
        height: 100%;
        background: #159957;
    }

    .progress-label {
        padding: 0 25px 18px;
        color: #666;
        font-size: 13px;
    }

    .pay-form {
        padding: 22px 25px 26px;
        display: flex;
        gap: 14px;
        align-items: flex-end;
        flex-wrap: wrap;
    }

        .pay-form label {
            display: block;
            font-size: 13px;
            color: #666;
            margin-bottom: 6px;
        }

        .pay-form input {
            padding: 11px 14px;
            border: 1px solid #aeb4ba;
            border-radius: 8px;
            font-size: 15px;
            min-width: 220px;
        }

    .pay-btn {
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        background: #111;
        color: #fff;
        font-weight: 700;
        cursor: pointer;
    }

        .pay-btn:hover {
            background: #333;
        }

    .paid-note {
        padding: 22px 25px;
        color: #159957;
        font-weight: 700;
    }
</style>

<div class="admin-page">

    <div class="page-header">
        <div>
            <h1>Invoice @Model.InvoiceNumber</h1>
            <p>
                @Model.ClientName &middot; @Model.ServiceName
            </p>
        </div>

        <div class="action-buttons">

            <a asp-controller="Admin"
               asp-action="Invoices"
               class="action-btn">
                <i class="bi bi-arrow-left"></i>
                All invoices
            </a>

            @if (!string.IsNullOrWhiteSpace(Model.BookingId))
            {
                <a asp-controller="Admin"
                   asp-action="EditBooking"
                   asp-route-id="@Model.BookingId"
                   class="action-btn">
                    <i class="bi bi-calendar-check"></i>
                    View booking
                </a>
            }

        </div>
    </div>

    <div class="detail-grid">

        <!-- CLIENT + INVOICE INFO -->
        <div class="content-card">

            <div class="card-header">
                <h2>Invoice Information</h2>
            </div>

            <div class="detail-body">

                <div class="detail-row">
                    <span>Invoice number</span>
                    <strong>@Model.InvoiceNumber</strong>
                </div>

                <div class="detail-row">
                    <span>Client</span>
                    <strong>@Model.ClientName</strong>
                </div>

                <div class="detail-row">
                    <span>Email</span>
                    <strong>@Model.ClientEmail</strong>
                </div>

                <div class="detail-row">
                    <span>Phone</span>
                    <strong>@Model.ClientPhone</strong>
                </div>

                <div class="detail-row">
                    <span>Service</span>
                    <strong>@Model.ServiceName</strong>
                </div>

                <div class="detail-row">
                    <span>Issued</span>
                    <strong>@Model.IssueDate.ToLocalTime().ToString("dd MMM yyyy")</strong>
                </div>

                <div class="detail-row">
                    <span>Due</span>
                    <strong>
                        @(Model.DueDate.HasValue
                            ? Model.DueDate.Value.ToLocalTime().ToString("dd MMM yyyy")
                            : "-")
                    </strong>
                </div>

            </div>

        </div>

        <!-- PAYMENT SUMMARY -->
        <div class="content-card">

            <div class="card-header">
                <h2>Payment Summary</h2>
            </div>

            <div class="detail-body">

                <div class="detail-row">
                    <span>Status</span>
                    <strong><span class="@payClass">@Model.PaymentStatus</span></strong>
                </div>

                <div class="detail-row">
                    <span>Total amount</span>
                    <strong>R @Model.TotalAmount.ToString("N2")</strong>
                </div>

                <div class="detail-row">
                    <span>Deposit required</span>
                    <strong>R @Model.DepositAmount.ToString("N2")</strong>
                </div>

                <div class="detail-row">
                    <span>Amount paid</span>
                    <strong>R @Model.AmountPaid.ToString("N2")</strong>
                </div>

                <div class="detail-row">
                    <span>Balance due</span>
                    <strong>R @Model.BalanceDue.ToString("N2")</strong>
                </div>

            </div>

            <div class="progress-track">
                <div class="progress-fill" style="width:@(percentPaid)%"></div>
            </div>

            <div class="progress-label">@percentPaid% paid</div>

        </div>

    </div>

    <!-- RECORD PAYMENT -->
    <div class="content-card" id="record-payment">

        <div class="card-header">
            <h2>Record a Payment</h2>
        </div>

        @if (Model.BalanceDue > 0)
        {
            <form asp-controller="Admin"
                  asp-action="RecordPayment"
                  method="post"
                  class="pay-form">

                <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />

                <div>
                    <label for="amount">Amount received (R)</label>
                    <input type="number"
                           id="amount"
                           name="amount"
                           min="0.01"
                           max="@Model.BalanceDue.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           step="0.01"
                           value="@Model.BalanceDue.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                           required />
                </div>

                <button type="submit" class="pay-btn">
                    <i class="bi bi-credit-card"></i>
                    Record Payment
                </button>

            </form>
        }
        else
        {
            <div class="paid-note">
                <i class="bi bi-check-circle-fill"></i>
                This invoice has been paid in full.
            </div>
        }

    </div>

</div>
