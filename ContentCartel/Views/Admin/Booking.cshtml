@model List<ContentCartel.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    bool Is(string? value, string expected) =>
        string.Equals(value?.Trim(), expected, StringComparison.OrdinalIgnoreCase);

    var all = Model ?? new List<ContentCartel.Models.Booking>();
}

<style>
    .admin-page {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        padding: 28px 30px 45px;
        overflow-x: hidden;
        box-sizing: border-box;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 800;
            color: #111;
        }

        .page-header p {
            margin: 8px 0 0;
            color: #666;
            font-size: 15px;
        }

    .content-card {
        width: 100%;
        min-width: 0;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .card-header {
        padding: 22px 25px;
        border-bottom: 1px solid #e5e5e5;
    }

        .card-header h2 {
            margin: 0;
            font-size: 19px;
            font-weight: 700;
            color: #111;
        }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .admin-table {
        width: 100%;
        min-width: 1100px;
        border-collapse: collapse;
    }

        .admin-table th {
            padding: 17px 20px;
            background: #fafafa;
            text-align: left;
            color: #111;
            font-size: 14px;
            font-weight: 700;
            border-bottom: 1px solid #ddd;
            white-space: nowrap;
        }

        .admin-table td {
            padding: 18px 20px;
            border-bottom: 1px solid #eee;
            color: #333;
            font-size: 14px;
            vertical-align: middle;
        }

        .admin-table tr:last-child td {
            border-bottom: none;
        }

    .invoice-number {
        font-weight: 700;
        color: #111;
    }

    .client-name {
        font-weight: 600;
        color: #222;
    }

    .service-name {
        color: #666;
        margin-top: 4px;
        font-size: 13px;
    }

    .amount {
        font-weight: 700;
        white-space: nowrap;
    }

    .balance {
        font-weight: 700;
        white-space: nowrap;
    }

    .status {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        border-radius: 7px;
        background: #159957;
        color: white;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-pending {
        background: #e6a817;
    }

    .status-partial {
        background: #2563eb;
    }

    .status-refunded {
        background: #777;
    }

    .status-cancelled {
        background: #c0392b;
    }

    .status-issued {
        background: #555;
    }

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 13px;
        border: 1px solid #aeb4ba;
        border-radius: 7px;
        background: white;
        color: #52606d;
        text-decoration: none;
        font-size: 14px;
        cursor: pointer;
        white-space: nowrap;
    }

        .action-btn:hover {
            background: #f5f5f5;
            color: #111;
        }

    .empty-state {
        padding: 60px 25px;
        text-align: center;
        color: #777;
    }

        .empty-state i {
            display: block;
            margin-bottom: 15px;
            font-size: 42px;
        }

        .empty-state h3 {
            margin: 0 0 8px;
            color: #333;
        }

        .empty-state p {
            margin: 0;
        }

    @@media (max-width: 700px) {
        .admin-page {
            padding: 22px 16px 35px;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    .stat-strip {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-box {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        padding: 18px 22px;
    }

        .stat-box span {
            display: block;
            color: #666;
            font-size: 13px;
            margin-bottom: 6px;
        }

        .stat-box strong {
            font-size: 26px;
            font-weight: 800;
            color: #111;
        }

    .action-btn.danger {
        color: #c0392b;
        border-color: #e3a49d;
    }

        .action-btn.danger:hover {
            background: #fdecea;
            color: #a93226;
        }

    .action-btn:disabled {
        opacity: .4;
        cursor: not-allowed;
    }

    .status-approved {
        background: #159957;
    }

    .status-completed {
        background: #2563eb;
    }
</style>

<div class="admin-page">

    <div class="page-header">
        <div>
            <h1>Bookings</h1>
            <p>Every booking made by clients. Edit, reschedule or cancel from here.</p>
        </div>
    </div>

    <div class="stat-strip">
        <div class="stat-box">
            <span>Total bookings</span>
            <strong>@all.Count</strong>
        </div>
        <div class="stat-box">
            <span>Pending</span>
            <strong>@all.Count(b => Is(b.Status, "Pending"))</strong>
        </div>
        <div class="stat-box">
            <span>Confirmed</span>
            <strong>@all.Count(b => Is(b.Status, "Confirmed") || Is(b.Status, "Approved"))</strong>
        </div>
        <div class="stat-box">
            <span>Cancelled</span>
            <strong>@all.Count(b => Is(b.Status, "Cancelled"))</strong>
        </div>
    </div>

    <div class="content-card">

        <div class="card-header">
            <h2>All Bookings</h2>
        </div>

        <div class="table-wrapper">

            @if (all.Any())
            {
                <table class="admin-table">

                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Service</th>
                            <th>Date &amp; Time</th>
                            <th>Total</th>
                            <th>Deposit</th>
                            <th>Booking Status</th>
                            <th>Payment</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var booking in all)
                        {
                            var statusText =
                                string.IsNullOrWhiteSpace(booking.Status)
                                    ? "Pending"
                                    : booking.Status;

                            var statusClass =
                                statusText.ToLowerInvariant() switch
                                {
                                    "confirmed" => "status status-approved",
                                    "approved" => "status status-approved",
                                    "completed" => "status status-completed",
                                    "cancelled" => "status status-cancelled",
                                    "rejected" => "status status-cancelled",
                                    _ => "status status-pending"
                                };

                            var payText =
                                string.IsNullOrWhiteSpace(booking.PaymentStatus)
                                    ? "Pending"
                                    : booking.PaymentStatus;

                            var payClass =
                                payText.ToUpperInvariant() switch
                                {
                                    "PAID" => "status",
                                    "PARTIALLY PAID" => "status status-partial",
                                    "PARTIAL" => "status status-partial",
                                    "REFUNDED" => "status status-refunded",
                                    _ => "status status-pending"
                                };

                            <tr>

                                <td>
                                    <div class="client-name">@booking.CustomerName</div>
                                    <div class="service-name">@booking.Email</div>
                                    @if (!string.IsNullOrWhiteSpace(booking.Phone))
                                    {
                                        <div class="service-name">@booking.Phone</div>
                                    }
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(booking.ServiceName)
                                        ? booking.ServiceId
                                        : booking.ServiceName)
                                </td>

                                <td>
                                    @booking.BookingDate.ToString("dd MMM yyyy")
                                    @if (!string.IsNullOrWhiteSpace(booking.BookingTime))
                                    {
                                        <div class="service-name">@booking.BookingTime</div>
                                    }
                                </td>

                                <td>
                                    <span class="amount">R @booking.TotalAmount.ToString("N2")</span>
                                </td>

                                <td>
                                    <span class="amount">R @booking.DepositAmount.ToString("N2")</span>
                                </td>

                                <td>
                                    <span class="@statusClass">@statusText</span>
                                </td>

                                <td>
                                    <span class="@payClass">@payText</span>
                                </td>

                                <td>
                                    <div class="action-buttons">

                                        <a asp-controller="Admin"
                                           asp-action="EditBooking"
                                           asp-route-id="@booking.Id"
                                           class="action-btn">
                                            <i class="bi bi-pencil"></i>
                                            Edit
                                        </a>

                                        <a asp-controller="Admin"
                                           asp-action="RescheduleBooking"
                                           asp-route-id="@booking.Id"
                                           class="action-btn">
                                            <i class="bi bi-calendar-event"></i>
                                            Reschedule
                                        </a>

                                        <form asp-controller="Admin"
                                              asp-action="CancelBooking"
                                              method="post"
                                              style="display:inline"
                                              onsubmit="return confirm('Cancel this booking?');">

                                            <input type="hidden" name="id" value="@booking.Id" />

                                            <button type="submit"
                                                    class="action-btn danger"
                                                    disabled="@(Is(booking.Status, "Cancelled"))">
                                                <i class="bi bi-x-circle"></i>
                                                Cancel
                                            </button>

                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <h3>No bookings yet</h3>
                    <p>Bookings made by clients will appear here.</p>
                </div>
            }

        </div>

    </div>

</div>
