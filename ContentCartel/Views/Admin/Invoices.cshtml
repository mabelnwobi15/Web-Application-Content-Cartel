@model List<ContentCartel.Models.Invoice>

@{
    ViewData["Title"] = "Invoicing & Payments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .admin-page {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        padding: 28px 30px 45px;
        overflow-x: hidden;
        box-sizing: border-box;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 800;
            color: #111;
        }

        .page-header p {
            margin: 8px 0 0;
            color: #666;
            font-size: 15px;
        }

    .content-card {
        width: 100%;
        min-width: 0;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .card-header {
        padding: 22px 25px;
        border-bottom: 1px solid #e5e5e5;
    }

        .card-header h2 {
            margin: 0;
            font-size: 19px;
            font-weight: 700;
            color: #111;
        }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .admin-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
    }

        .admin-table th {
            padding: 17px 20px;
            background: #fafafa;
            text-align: left;
            color: #111;
            font-size: 14px;
            font-weight: 700;
            border-bottom: 1px solid #ddd;
            white-space: nowrap;
        }

        .admin-table td {
            padding: 18px 20px;
            border-bottom: 1px solid #eee;
            color: #333;
            font-size: 14px;
            vertical-align: middle;
        }

        .admin-table tr:last-child td {
            border-bottom: none;
        }

    .invoice-number {
        font-weight: 700;
        color: #111;
    }

    .client-name {
        font-weight: 600;
        color: #222;
    }

    .service-name {
        color: #666;
        margin-top: 4px;
        font-size: 13px;
    }

    .amount {
        font-weight: 700;
        white-space: nowrap;
    }

    .balance {
        font-weight: 700;
        white-space: nowrap;
    }

    .status {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        border-radius: 7px;
        background: #159957;
        color: white;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-pending {
        background: #e6a817;
    }

    .status-partial {
        background: #2563eb;
    }

    .status-refunded {
        background: #777;
    }

    .status-cancelled {
        background: #c0392b;
    }

    .status-issued {
        background: #555;
    }

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 13px;
        border: 1px solid #aeb4ba;
        border-radius: 7px;
        background: white;
        color: #52606d;
        text-decoration: none;
        font-size: 14px;
        cursor: pointer;
        white-space: nowrap;
    }

        .action-btn:hover {
            background: #f5f5f5;
            color: #111;
        }

    .empty-state {
        padding: 60px 25px;
        text-align: center;
        color: #777;
    }

        .empty-state i {
            display: block;
            margin-bottom: 15px;
            font-size: 42px;
        }

        .empty-state h3 {
            margin: 0 0 8px;
            color: #333;
        }

        .empty-state p {
            margin: 0;
        }

    @@media (max-width: 700px) {
        .admin-page {
            padding: 22px 16px 35px;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="admin-page">

    <div class="page-header">
        <div>
            <h1>Invoicing & Payments</h1>
            <p>Manage invoices, payments, balances and refunds.</p>
        </div>
    </div>

    <div class="content-card">

        <div class="card-header">
            <h2>Invoices</h2>
        </div>

        <div class="table-wrapper">

            @if (Model != null && Model.Any())
            {
                <table class="admin-table">

                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Client</th>
                            <th>Booking</th>
                            <th>Total Amount</th>
                            <th>Amount Paid</th>
                            <th>Balance</th>
                            <th>Payment Status</th>
                            <th>Issue Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var invoice in Model)
                        {
                            <tr>

                                <td>
                                    <span class="invoice-number">
                                        @invoice.InvoiceNumber
                                    </span>
                                </td>

                                <td>
                                    <div class="client-name">
                                        @invoice.ClientName
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(invoice.ClientEmail))
                                    {
                                        <div class="service-name">
                                            @invoice.ClientEmail
                                        </div>
                                    }
                                </td>

                                <td>
                                    #@invoice.BookingId
                                    <div class="service-name">
                                        @invoice.ServiceName
                                    </div>
                                </td>

                                <td>
                                    <span class="amount">
                                        R @invoice.TotalAmount.ToString("N2")
                                    </span>
                                </td>

                                <td>
                                    <span class="amount">
                                        R @invoice.AmountPaid.ToString("N2")
                                    </span>
                                </td>

                                <td>
                                    <span class="balance">
                                        R @invoice.BalanceDue.ToString("N2")
                                    </span>
                                </td>

                                <td>
                                    @{
                                        var paymentStatus =
                                            invoice.PaymentStatus?.ToUpperInvariant();

                                        var statusClass =
                                            paymentStatus switch
                                            {
                                                "PENDING"
                                                    => "status status-pending",

                                                "PARTIAL"
                                                    => "status status-partial",

                                                "PARTIALLY PAID"
                                                    => "status status-partial",

                                                "PAID"
                                                    => "status",

                                                "REFUNDED"
                                                    => "status status-refunded",

                                                "CANCELLED"
                                                    => "status status-cancelled",

                                                _
                                                    => "status status-issued"
                                            };
                                    }

                                    <span class="@statusClass">
                                        @invoice.PaymentStatus
                                    </span>
                                </td>

                                <td>
                                    @invoice.IssueDate
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <div class="action-buttons">

                                        <a asp-controller="Admin"
                                           asp-action="InvoiceDetails"
                                           asp-route-id="@invoice.InvoiceId"
                                           class="action-btn">
                                            <i class="bi bi-eye"></i>
                                            View
                                        </a>

                                        @if (invoice.BalanceDue > 0)
                                        {
                                            <a asp-controller="Admin"
                                               asp-action="RecordPayment"
                                               asp-route-id="@invoice.InvoiceId"
                                               class="action-btn">
                                                <i class="bi bi-credit-card"></i>
                                                Payment
                                            </a>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-state">

                    <i class="bi bi-receipt"></i>

                    <h3>No invoices available</h3>

                    <p>
                        Invoices will appear here when bookings are invoiced.
                    </p>

                </div>
            }

        </div>

    </div>

</div>